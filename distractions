#!/usr/bin/env python3
"""Named native workspace `distraction`, not overlay and not Super+1-0."""

from __future__ import annotations

import json
import os
import shutil
import socket
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

NAME = "distraction"
REF = f"name:{NAME}"
SAFE_ID = 99
MIN_REASON = 50
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "omarchy"
CONFIG_PATH = Path.home() / ".config/omarchy/focus.json"
FOCUS = STATE_DIR / "distractions.focus"
LISTEN_LOCK = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "distractions.listen.lock"
DEFAULT_LOG = STATE_DIR / "focus-disable.log"
PLUGIN_DIR = Path(__file__).resolve().parent
APP_LIST_DEFAULTS = PLUGIN_DIR / "app-list-defaults.json"
LAST_GOOD_EXPAND_NAME = "distraction-apps.last-good.json"

# Class matchers match hypr/windows.lua. Hosts are independently optional.
EXPAND_MAP: dict[str, dict] = {
    "Telegram": {
        "class": "org.telegram.desktop",
        "hosts": ["web.telegram.org"],
    },
    "Discord": {
        "class": r"^chrome-discord\.com__.*$",
        "hosts": ["discord.com", "www.discord.com"],
    },
    "WhatsApp": {
        "class": r"^chrome-web\.whatsapp\.com__.*$",
        "hosts": ["web.whatsapp.com"],
    },
    "X": {
        "class": r"^chrome-x\.com__.*$",
        "hosts": ["x.com", "www.x.com", "twitter.com", "www.twitter.com"],
    },
    "Signal": {
        "class": r"^signal$",
        "hosts": ["signal.org", "www.signal.org"],
    },
    "Google Messages": {
        "class": r"^chrome-messages\.google\.com__.*$",
        "hosts": ["messages.google.com"],
    },
    "Facebook": {"hosts": ["facebook.com", "www.facebook.com"]},
    "Instagram": {"hosts": ["instagram.com", "www.instagram.com"]},
    "Threads": {"hosts": ["threads.net", "www.threads.net"]},
    "Reddit": {"hosts": ["reddit.com", "www.reddit.com"]},
    "TikTok": {"hosts": ["tiktok.com", "www.tiktok.com"]},
    "Snapchat": {"hosts": ["snapchat.com", "www.snapchat.com"]},
    "YouTube": {
        "hosts": ["youtube.com", "www.youtube.com", "youtu.be", "m.youtube.com"],
    },
    "Twitch": {"hosts": ["twitch.tv", "www.twitch.tv"]},
    "Netflix": {"hosts": ["netflix.com", "www.netflix.com"]},
}


def hyprctl(*args: str) -> str:
    return subprocess.check_output(["hyprctl", *args], text=True)


def hyprctl_json(*args: str):
    return json.loads(hyprctl("-j", *args))


def dispatch(lua: str) -> None:
    subprocess.check_call(["hyprctl", "dispatch", lua])


def notify(title: str, body: str = "", timeout_ms: int = 4000) -> None:
    cmd = ["omarchy-notification-send", "-u", "normal", "-t", str(timeout_ms), title]
    if body:
        cmd.append(body)
    try:
        subprocess.check_call(cmd)
    except (subprocess.CalledProcessError, FileNotFoundError):
        subprocess.call(["notify-send", "-t", str(timeout_ms), title, body])


def load_config() -> dict:
    if not CONFIG_PATH.exists():
        return {}
    try:
        data = json.loads(CONFIG_PATH.read_text())
    except json.JSONDecodeError:
        return {}
    return data if isinstance(data, dict) else {}


def log_path() -> Path:
    raw = load_config().get("log", str(DEFAULT_LOG))
    path = Path(os.path.expanduser(str(raw)))
    path.parent.mkdir(parents=True, exist_ok=True)
    return path


def app_list_path() -> Path:
    return Path.home() / ".config/omarchy/app-list.json"


def last_good_expand_path() -> Path:
    state = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "omarchy"
    return state / LAST_GOOD_EXPAND_NAME


def sanitize_product(name: str) -> str:
    return "".join(ch for ch in name.lower() if ch.isalnum())


def window_rule_name(name: str) -> str:
    return f"omarchy-ds-{sanitize_product(name)}"


def _atomic_write(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.tmp")
    tmp.write_text(text, encoding="utf-8")
    tmp.replace(path)


def _read_json_list(path: Path) -> list | None:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        return None
    return data if isinstance(data, list) else None


def _entry_name(entry: object) -> str | None:
    if not isinstance(entry, dict):
        return None
    name = entry.get("name")
    if not isinstance(name, str):
        return None
    name = name.strip()
    return name or None


def _entry_class(entry: dict, mapped: dict | None) -> str | None:
    raw = entry.get("class")
    if isinstance(raw, str) and raw.strip():
        return raw.strip()
    mapped_class = (mapped or {}).get("class")
    if isinstance(mapped_class, str) and mapped_class:
        return mapped_class
    return None


def _entry_hosts(entry: dict, mapped: dict | None) -> list[str]:
    raw = entry.get("hosts")
    if isinstance(raw, list):
        return [host.strip() for host in raw if isinstance(host, str) and host.strip()]
    mapped_hosts = (mapped or {}).get("hosts") or []
    return [host for host in mapped_hosts if isinstance(host, str) and host]


def expand_entries(entries: list) -> list[dict]:
    accepted: list[tuple[str, str | None, list[str]]] = []
    seen: set[str] = set()
    for entry in entries:
        if not isinstance(entry, dict):
            continue
        name = _entry_name(entry)
        if name is None or name in seen:
            continue
        seen.add(name)
        mapped = EXPAND_MAP.get(name)
        klass = _entry_class(entry, mapped)
        hosts = _entry_hosts(entry, mapped)
        if mapped is None and not klass and not hosts:
            continue
        accepted.append((name, klass, hosts))
    slugs: dict[str, list[str]] = {}
    for name, _klass, _hosts in accepted:
        slugs.setdefault(sanitize_product(name), []).append(name)
    colliding = {
        name
        for names in slugs.values()
        if len(names) > 1
        for name in names
    }
    expanded = []
    for name, klass, hosts in accepted:
        if name in colliding:
            continue
        expanded.append({"name": name, "class": klass, "hosts": hosts})
    return expanded


def load_last_good_expand(path: Path | None = None) -> list[dict]:
    target = path or last_good_expand_path()
    rows = _read_json_list(target)
    if rows is None:
        return []
    return [row for row in rows if isinstance(row, dict)]


def save_last_good_expand(rows: list[dict], path: Path | None = None) -> None:
    target = path or last_good_expand_path()
    _atomic_write(target, json.dumps(rows, indent=2) + "\n")


def prepare_app_list(
    user_path: Path | None = None,
    defaults_path: Path | None = None,
) -> list | None:
    """Load the user list. Missing file copies shipped defaults.

    Returns the raw JSON list, or None when a present file is invalid
    (caller keeps last-good expand). A missing defaults file starts empty.
    """
    user = user_path or app_list_path()
    defaults = defaults_path or APP_LIST_DEFAULTS
    if user.exists():
        rows = _read_json_list(user)
        if rows is None:
            notify(
                "Distraction list",
                "The app list file is invalid and was left unchanged.",
            )
            return None
        return rows
    shipped = _read_json_list(defaults) if defaults.exists() else None
    if shipped is None:
        notify(
            "Distraction list",
            "Shipped app list defaults are missing. Starting with an empty list.",
        )
        return []
    user.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(defaults, user)
    return shipped


def app_list_for_apply(
    user_path: Path | None = None,
    defaults_path: Path | None = None,
    last_good_path: Path | None = None,
) -> list[dict]:
    raw = prepare_app_list(user_path=user_path, defaults_path=defaults_path)
    if raw is None:
        return load_last_good_expand(last_good_path)
    expanded = expand_entries(raw)
    save_last_good_expand(expanded, last_good_path)
    return expanded


def print_expand(
    user_path: Path | None = None,
    defaults_path: Path | None = None,
    last_good_path: Path | None = None,
) -> None:
    raw = prepare_app_list(user_path=user_path, defaults_path=defaults_path)
    if raw is None:
        print("[]")
        return
    expanded = expand_entries(raw)
    save_last_good_expand(expanded, last_good_path)
    print(json.dumps(expanded, indent=2))


def current() -> dict:
    return hyprctl_json("activeworkspace")


def current_id() -> int:
    return int(current()["id"])


def is_distraction(workspace: dict) -> bool:
    name = str(workspace.get("name") or "")
    return name == NAME or name == REF or int(workspace.get("id") or 0) == SAFE_ID


def on_distractions() -> bool:
    return is_distraction(current())


def occupied_ids() -> list[int]:
    workspaces = hyprctl_json("workspaces")
    return sorted({workspace["id"] for workspace in workspaces if workspace["id"] > 0})


def skip_ids() -> set[int]:
    return {workspace["id"] for workspace in hyprctl_json("workspaces") if is_distraction(workspace)}


def focus_workspace(workspace: str) -> None:
    dispatch(f'hl.dsp.focus({{ workspace = "{workspace}" }})')


def pin_id() -> None:
    # Named workspaces often get a Hyprland-managed id (e.g. -1337) which
    # already sits outside Super+1-0 and the 1-10 bar. Only retarget if a
    # numbered slot 1-10 got used.
    for workspace in hyprctl_json("workspaces"):
        if not is_distraction(workspace):
            continue
        ident = int(workspace["id"])
        if ident < 1 or ident > 10:
            return
        dispatch(
            f'hl.dsp.workspace.change_id({{ workspace = "{REF}", id = {SAFE_ID} }})'
        )
        return


def show() -> None:
    if not on_distractions():
        focus_workspace(REF)
    pin_id()


def hide() -> None:
    if not on_distractions():
        return
    focus_workspace("previous")
    if on_distractions():
        focus_workspace("1")


def is_focus() -> bool:
    if not FOCUS.exists():
        return True
    return FOCUS.read_text().strip().lower() != "off"


def set_focus(value: bool) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    FOCUS.write_text("on\n" if value else "off\n")


def ensure_focus_default() -> None:
    if not FOCUS.exists():
        set_focus(True)


def blocked_message() -> None:
    notify(
        "Focus mode is on",
        "The distraction space is locked. Super+Ctrl+Shift+F, then a 50-character reason, to leave.",
    )


def enter() -> None:
    if on_distractions():
        return
    if is_focus():
        blocked_message()
        return
    show()


def toggle() -> None:
    if on_distractions():
        hide()
        return
    enter()


def cycle(step: int) -> None:
    ids = occupied_ids()
    current = current_id()
    if current not in ids:
        ids.append(current)
        ids.sort()
    if not ids:
        return
    index = ids.index(current)
    for _ in range(len(ids)):
        index = (index + step) % len(ids)
        candidate = ids[index]
        if candidate not in skip_ids():
            focus_workspace(str(candidate))
            return


def enable_focus() -> None:
    set_focus(True)
    if on_distractions():
        hide()
    notify("Focus mode on", "The distraction space is locked. Super+D will not open it.")


def disable_focus(reason: str) -> None:
    reason = " ".join(reason.split())
    if len(reason) < MIN_REASON:
        raise SystemExit(
            f"reason must be at least {MIN_REASON} characters (got {len(reason)})"
        )
    stamp = datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds")
    with log_path().open("a", encoding="utf-8") as handle:
        handle.write(f"{stamp}  {reason}\n")
    set_focus(False)
    notify("Focus mode off", "Super+D opens the distraction space.")


def prompt_reason() -> str | None:
    try:
        result = subprocess.run(
            [
                "zenity",
                "--entry",
                "--title=Leave focus mode",
                "--text=Write at least 50 characters on why you are leaving focus mode.",
                "--width=520",
                "--ok-label=Turn off",
                "--cancel-label=Stay focused",
            ],
            capture_output=True,
            text=True,
            check=False,
        )
    except FileNotFoundError:
        notify("Focus mode", "zenity is missing; cannot ask for a reason.")
        return None
    if result.returncode != 0:
        return None
    return result.stdout.strip()


def request_focus_toggle() -> None:
    if not is_focus():
        enable_focus()
        return
    reason = prompt_reason()
    if reason is None:
        return
    try:
        disable_focus(reason)
    except SystemExit as exc:
        notify("Focus mode", str(exc))


def listen() -> None:
    ensure_focus_default()
    pin_id()
    runtime = Path(os.environ["XDG_RUNTIME_DIR"])
    signature = os.environ["HYPRLAND_INSTANCE_SIGNATURE"]
    sock_path = runtime / "hypr" / signature / ".socket2.sock"

    lock = open(LISTEN_LOCK, "w")
    try:
        import fcntl

        fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return

    if is_focus() and on_distractions():
        hide()

    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.connect(str(sock_path))
    with sock.makefile("r") as events:
        for _line in events:
            if is_focus() and on_distractions():
                hide()


def main() -> None:
    command = sys.argv[1] if len(sys.argv) > 1 else "toggle"
    if command == "toggle":
        toggle()
    elif command == "enter":
        enter()
    elif command == "next":
        cycle(1)
    elif command == "prev":
        cycle(-1)
    elif command == "listen":
        listen()
    elif command in {"focus", "focus-toggle"}:
        request_focus_toggle()
    elif command == "focus-on":
        if not is_focus():
            enable_focus()
    elif command == "focus-off":
        reason = " ".join(sys.argv[2:]).strip()
        if not reason and not sys.stdin.isatty():
            reason = sys.stdin.read().strip()
        disable_focus(reason)
    elif command == "focus-status":
        raise SystemExit(0 if is_focus() else 1)
    elif command == "log-path":
        print(log_path())
    elif command == "print-expand":
        print_expand()
    else:
        raise SystemExit(f"unknown command: {command}")


if __name__ == "__main__":
    main()

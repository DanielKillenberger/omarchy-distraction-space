def _open_exclusive_lock(path: Path):
    path.parent.mkdir(parents=True, exist_ok=True)
    return open(path, "w")


def _lock_summary_state(timeout_s: float | None = None):
    timeout = CAPTURE_LOCK_TIMEOUT_S if timeout_s is None else timeout_s
    handle = _open_exclusive_lock(SUMMARY_STATE_LOCK)
    deadline = time.monotonic() + timeout
    while True:
        try:
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
            return handle
        except BlockingIOError:
            if time.monotonic() >= deadline:
                handle.close()
                raise TimeoutError("summary-state.lock")
            time.sleep(0.01)


def try_summarize_session_lock():
    handle = _open_exclusive_lock(SUMMARIZE_SESSION_LOCK)
    try:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        handle.close()
        return None
    return handle


def _lock_focus_transition():
    handle = _open_exclusive_lock(FOCUS_TRANSITION_LOCK)
    fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
    return handle


def _pid_starttime(pid: int | None) -> str:
    if not pid:
        return ""
    try:
        return Path(f"/proc/{int(pid)}/stat").read_text().split()[21]
    except (OSError, IndexError, ValueError, TypeError):
        return ""


def _pid_matches(pid: int | None, starttime: str | None) -> bool:
    if not pid or not starttime:
        return False
    current = _pid_starttime(pid)
    return bool(current) and current == str(starttime)


def _kill_pid(pid: int | None, starttime: str | None = None) -> None:
    if not _pid_matches(pid, starttime):
        return
    try:
        os.kill(int(pid), signal.SIGTERM)
    except (OSError, TypeError, ValueError):
        pass
    try:
        os.killpg(int(pid), signal.SIGTERM)
    except OSError:
        pass
    deadline = time.monotonic() + 1.0
    while time.monotonic() < deadline and _pid_matches(pid, starttime):
        time.sleep(0.05)
    if not _pid_matches(pid, starttime):
        return
    try:
        os.killpg(int(pid), signal.SIGKILL)
    except OSError:
        pass
    try:
        os.kill(int(pid), signal.SIGKILL)
    except OSError:
        pass


def _record_agent_pid(
    pid: int | None,
    expected_session: str,
    *,
    expected_pid: int | None = None,
) -> bool:
    try:
        lock = _lock_summary_state()
    except (TimeoutError, OSError):
        return False
    try:
        control = read_summary_control()
        if not expected_session or control.get("session_id") != expected_session:
            return False
        if pid:
            starttime = _pid_starttime(pid)
            if not starttime:
                return False
            current_pid = control.get("agent_pid")
            current_starttime = control.get("agent_starttime")
            if current_pid and int(current_pid) != int(pid) and _pid_matches(current_pid, current_starttime):
                return False
            control["agent_pid"] = int(pid)
            control["agent_starttime"] = starttime
        else:
            if expected_pid is not None and int(control.get("agent_pid") or 0) != int(expected_pid):
                return False
            control["agent_pid"] = None
            control["agent_starttime"] = ""
        write_summary_control(control)
        return True
    except Exception:
        return False
    finally:
        lock.close()


def reap_summary_children(control: dict | None = None) -> None:
    payload = control if control is not None else read_summary_control()
    _kill_pid(payload.get("agent_pid"), payload.get("agent_starttime"))
    if control is not None:
        control["agent_pid"] = None
        control["agent_starttime"] = ""


def prepare_summary_session(*, force_new: bool = False) -> dict:
    lock = _lock_summary_state()
    try:
        previous = read_summary_control()
        reap_summary_children(previous)
        if previous.get("lift_fail_pending") and not force_new:
            previous["finish_requested"] = False
            previous["parser_closed"] = False
            previous["session_ready"] = False
            previous["mute_applied_session"] = ""
            previous["agent_pid"] = None
            write_summary_control(previous)
            return previous
        control = default_summary_control()
        control["session_id"] = uuid.uuid4().hex
        result = summary_result_path()
        if result.exists():
            result.unlink()
        ping = ping_text_path()
        if ping.exists():
            ping.unlink()
        write_summary_control(control)
        return control
    finally:
        lock.close()


def mute_applied_for_session(control: dict, session_id: str | None = None) -> bool:
    current = session_id if session_id is not None else control.get("session_id")
    return bool(current and control.get("mute_applied_session") == current)


def record_mute_applied(session_id: str) -> bool:
    if not session_id or not is_focus():
        return False
    lock = _lock_summary_state()
    try:
        control = read_summary_control()
        if not is_focus() or control.get("session_id") != session_id:
            return False
        control["mute_applied_session"] = session_id
        write_summary_control(control)
        return True
    finally:
        lock.close()


def revoke_mute_applied() -> dict:
    lock = _lock_summary_state()
    try:
        control = read_summary_control()
        if control.get("mute_applied_session") or control.get("session_ready"):
            control["mute_applied_session"] = ""
            control["session_ready"] = False
            write_summary_control(control)
        return control
    finally:
        lock.close()


def publish_summary_after_mute(*, resume: bool = False) -> dict:
    """Record the session mute token and ready marker. Caller already applied mute."""
    if not is_focus() or not agent_summaries_enabled():
        return read_summary_control()
    control = read_summary_control()
    if not control.get("session_id"):
        control = prepare_summary_session()
    session_id = control.get("session_id")
    if not session_id or not is_focus():
        return read_summary_control()
    if not record_mute_applied(session_id):
        return revoke_mute_applied()
    return mark_summary_session_ready(resume=resume, expected_session=session_id)


def arm_summary_after_mute(*, resume: bool = False) -> dict:
    if not is_focus() or not agent_summaries_enabled():
        return read_summary_control()
    if not apply_notification_block() or not is_focus():
        return revoke_mute_applied()
    return publish_summary_after_mute(resume=resume)


def mark_summary_session_ready(
    *,
    resume: bool = False,
    expected_session: str | None = None,
) -> dict:
    lock = _lock_summary_state()
    try:
        control = read_summary_control()
        session_id = control.get("session_id")
        if expected_session and session_id != expected_session:
            return control
        if (
            not is_focus()
            or not agent_summaries_enabled()
            or not session_id
            or not mute_applied_for_session(control, session_id)
        ):
            return control
        if resume:
            control["finish_requested"] = False
            control["parser_closed"] = False
        if control.get("finish_requested"):
            return control
        control["session_ready"] = True
        write_summary_control(control)
        return control
    finally:
        lock.close()


def request_summary_finish(
    expected_session: str | None = None,
    *,
    reap: bool = True,
) -> dict:
    lock = _lock_summary_state()
    try:
        control = read_summary_control()
        if expected_session and control.get("session_id") != expected_session:
            return control
        control["finish_requested"] = True
        control["parser_active"] = False
        control["session_ready"] = False
        control["mute_applied_session"] = ""
        if reap:
            reap_summary_children(control)
        write_summary_control(control)
        return control
    finally:
        lock.close()


def _capture_record_valid(payload) -> dict | None:
    if not isinstance(payload, dict):
        return None
    app = payload.get("app")
    title = payload.get("title")
    body = payload.get("body")
    at = payload.get("at")
    if not isinstance(app, str) or not isinstance(title, str) or not isinstance(body, str):
        return None
    if not isinstance(at, str) or not at.strip():
        return None
    return {
        "app": app[:CAPTURE_FIELD_MAX],
        "title": title[:CAPTURE_FIELD_MAX],
        "body": body[:CAPTURE_FIELD_MAX],
        "at": at[:CAPTURE_FIELD_MAX],
    }


def _trim_jsonl_lines(lines: list[str], max_bytes: int) -> list[str]:
    kept = list(lines)
    while kept and sum(len(line.encode()) for line in kept) > max_bytes:
        kept.pop(0)
    return kept


def write_ping_jsonl(lines: list[str]) -> None:
    write_private_atomic(ping_text_path(), "".join(lines))


def read_ping_records() -> list[dict]:
    path = ping_text_path()
    if not path.exists():
        return []
    records = []
    for raw in path.read_text().splitlines():
        if not raw.strip():
            continue
        try:
            item = json.loads(raw)
        except json.JSONDecodeError:
            continue
        if isinstance(item, dict) and isinstance(item.get("seq"), int):
            records.append(item)
    return records


def capture_ping(payload) -> dict:
    record = _capture_record_valid(payload)
    if record is None:
        raise ValueError("invalid capture payload")
    if not is_focus():
        raise ValueError("not focused")
    if not agent_summaries_enabled():
        raise ValueError("summaries disabled")
    lock = _lock_summary_state()
    try:
        control = read_summary_control()
        expected = payload.get("session") if isinstance(payload, dict) else None
        if (
            not control.get("session_ready")
            or not control.get("session_id")
            or control.get("parser_closed")
            or control.get("finish_requested")
            or not mute_applied_for_session(control)
            or (expected and control.get("session_id") != expected)
        ):
            raise ValueError("stale session")
        seq = int(control.get("next_seq") or 1)
        control["next_seq"] = seq + 1
        write_summary_control(control)
        line = json.dumps({"seq": seq, **record}, separators=(",", ":")) + "\n"
        existing = []
        path = ping_text_path()
        if path.exists():
            existing = [ln if ln.endswith("\n") else ln + "\n" for ln in path.read_text().splitlines() if ln]
        kept = _trim_jsonl_lines(existing + [line], PING_JSONL_MAX_BYTES)
        write_ping_jsonl(kept)
        return {"seq": seq, **record}
    finally:
        lock.close()


def cmd_capture_ping() -> None:
    try:
        raw = sys.stdin.read(CAPTURE_STDIN_MAX + 1)
        if len(raw) > CAPTURE_STDIN_MAX:
            raise ValueError("capture stdin exceeds bound")
        payload = json.loads(raw) if raw.strip() else None
        capture_ping(payload)
    except (json.JSONDecodeError, TypeError, ValueError, TimeoutError, OSError):
        raise SystemExit(1)


def _session_matches(control: dict, expected_session: str | None) -> bool:
    return not expected_session or control.get("session_id") == expected_session


def _parser_may_start(control: dict, expected_session: str | None = None) -> bool:
    session_id = expected_session or control.get("session_id")
    return bool(
        _session_matches(control, expected_session)
        and control.get("session_id")
        and control.get("session_ready")
        and mute_applied_for_session(control, session_id)
        and not control.get("finish_requested")
        and not control.get("parser_closed")
        and agent_summaries_enabled()
        and is_focus()
    )


def mark_parser_active(expected_session: str | None = None) -> dict:
    lock = _lock_summary_state()
    try:
        control = read_summary_control()
        if not _parser_may_start(control, expected_session):
            raise ValueError("parser start rejected")
        control["parser_active"] = True
        write_summary_control(control)
        return control
    finally:
        lock.close()


def apply_parser_restart(expected_session: str | None = None) -> dict | None:
    lock = _lock_summary_state()
    try:
        control = read_summary_control()
        if not _parser_may_start(control, expected_session):
            return None
        reap_summary_children(control)
        current = int(control.get("parser_restarts") or 0)
        if current >= PARSER_RESTART_MAX:
            control["parser_closed"] = True
            control["parser_active"] = False
            control["session_ready"] = False
            control["parse_failed"] = True
            write_summary_control(control)
            return None
        control["parser_restarts"] = current + 1
        control["parser_active"] = True
        write_summary_control(control)
        sleep_for = PARSER_RESTART_SLEEPS[current]
    finally:
        lock.close()
    time.sleep(sleep_for)
    lock = _lock_summary_state()
    try:
        control = read_summary_control()
        if not _parser_may_start(control, expected_session):
            return None
        return control
    finally:
        lock.close()


def clear_parser_running(expected_session: str | None = None) -> dict:
    lock = _lock_summary_state()
    try:
        control = read_summary_control()
        if not _session_matches(control, expected_session):
            return control
        control["parser_active"] = False
        if control.get("finish_requested") or control.get("parser_closed"):
            control["session_ready"] = False
        write_summary_control(control)
        return control
    finally:
        lock.close()


def should_stop_parser(control: dict | None = None) -> bool:
    payload = control if control is not None else read_summary_control()
    return bool(
        payload.get("finish_requested")
        or payload.get("parser_closed")
        or not payload.get("session_ready")
        or not agent_summaries_enabled()
    )


def observe_ping_records(last_seen_seq: int) -> list[dict]:
    unseen = [row for row in read_ping_records() if int(row.get("seq") or 0) > last_seen_seq]
    unseen.sort(key=lambda row: int(row.get("seq") or 0))
    return unseen


def summary_ledger_path() -> Path:
    return STATE_DIR / "focus-summary-ledger.jsonl"


def _lock_summary_result():
    handle = _open_exclusive_lock(SUMMARY_RESULT_LOCK)
    fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
    return handle


def read_ledger_prompt() -> str:
    path = summary_ledger_path()
    if not path.exists():
        return ""
    lines = path.read_text(encoding="utf-8", errors="replace").splitlines()[-LEDGER_PROMPT_LINES:]
    while lines and len("\n".join(lines).encode()) > LEDGER_PROMPT_BYTES:
        lines.pop(0)
    return "\n".join(lines)


def _lock_summary_ledger():
    handle = _open_exclusive_lock(SUMMARY_LEDGER_LOCK)
    fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
    return handle


def prompt_ledger_note() -> str:
    try:
        result = subprocess.run(
            [
                "zenity",
                "--entry",
                "--title=Summary feedback",
                "--text=Optional note. Leave empty or cancel to skip the note.",
                "--width=520",
            ],
            capture_output=True,
            text=True,
            check=False,
        )
    except FileNotFoundError:
        return ""
    if result.returncode != 0:
        return ""
    return (result.stdout or "").strip()


def append_ledger_entry(helpful: bool, note: str) -> bool:
    if not isinstance(helpful, bool) or not isinstance(note, str):
        notify("Focus mode", "Could not save summary feedback.")
        return False
    payload = {
        "at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "helpful": helpful,
        "note": _truncate_bytes(note, LEDGER_NOTE_MAX),
    }
    lock = None
    try:
        line = json.dumps(payload, separators=(",", ":")) + "\n"
        if len(line.encode()) > LEDGER_PROMPT_BYTES:
            notify("Focus mode", "Could not save summary feedback.")
            return False
        lock = _lock_summary_ledger()
        path = summary_ledger_path()
        path.parent.mkdir(parents=True, exist_ok=True)
        existing = path.read_text(encoding="utf-8") if path.exists() else ""
        write_private_atomic(path, existing + line)
        return True
    except (TypeError, ValueError, OSError):
        notify("Focus mode", "Could not save summary feedback.")
        return False
    finally:
        if lock is not None:
            lock.close()


def collect_summary_feedback() -> dict | None:
    try:
        selected = menu_select(
            "Was this summary helpful?",
            list(LEDGER_FEEDBACK_OPTIONS),
            quiet=True,
        )
        if selected == "Helpful":
            helpful = True
        elif selected == "Not helpful":
            helpful = False
        else:
            return None
        note = prompt_ledger_note()
        if append_ledger_entry(helpful, note):
            return {"helpful": helpful, "note": _truncate_bytes(note, LEDGER_NOTE_MAX)}
        return None
    except Exception:
        notify("Focus mode", "Could not save summary feedback.")
        return None


def _record_prompt_piece(row: dict) -> str:
    return f"{row.get('title') or ''}\n{row.get('body') or ''}\n"


def select_prompt_records(records: list[dict], consumed: int = 0) -> tuple[list[dict], int]:
    fresh = [row for row in records if int(row.get("seq") or 0) > consumed]
    included: list[dict] = []
    skipped_to = consumed
    used = 0
    for row in fresh:
        seq = int(row.get("seq") or 0)
        extra = len(_record_prompt_piece(row).encode())
        if extra > PARSE_MAX_PROMPT_BYTES:
            if not included:
                skipped_to = seq
            continue
        if len(included) >= PARSE_MAX_RECORDS:
            break
        if used + extra > PARSE_MAX_PROMPT_BYTES:
            break
        included.append(row)
        used += extra
        skipped_to = seq
    return included, skipped_to


def build_summary_prompt(records: list[dict]) -> str:
    chosen, _ = select_prompt_records(records, 0)
    chunks = [_record_prompt_piece(row) for row in chosen]
    ledger = read_ledger_prompt()
    if ledger:
        chunks.append(ledger if ledger.endswith("\n") else ledger + "\n")
    return "".join(chunks)


def read_summary_result() -> dict:
    data = read_json(summary_result_path(), {})
    return data if isinstance(data, dict) else {}


def publish_summary_result(text: str, session_id: str) -> dict:
    payload = {
        "session_id": session_id,
        "text": _truncate_bytes(text or "", PARSE_RESULT_MAX),
    }
    lock = _lock_summary_result()
    try:
        write_private_atomic(summary_result_path(), json.dumps(payload) + "\n")
        return payload
    finally:
        lock.close()


def reserve_parse_invocation(
    records: list[dict],
    expected_session: str | None = None,
    *,
    finishing: bool = False,
    agent_id: str = "",
) -> dict | None:
    lock = _lock_summary_state()
    try:
        control = read_summary_control()
        session_id = control.get("session_id")
        if expected_session and session_id != expected_session:
            return None
        if not session_id:
            return None
        proof_needed = agent_id == "grok" and not bool(control.get("grok_proven"))
        slots = 2 if proof_needed else 1
        invocations = int(control.get("invocations") or 0)
        if invocations + slots > PARSE_MAX_INVOCATIONS:
            return None
        if finishing:
            if int(control.get("parser_restarts") or 0) >= PARSER_RESTART_MAX:
                return None
            if control.get("parser_closed") and not control.get("finish_requested"):
                return None
        elif not _parser_may_start(control, expected_session):
            return None
        consumed = int(control.get("last_consumed_seq") or 0)
        included, consumed_through = select_prompt_records(records, consumed)
        if consumed_through > consumed and not included:
            control["last_consumed_seq"] = consumed_through
            write_summary_control(control)
            return None
        if not included:
            return None
        control["invocations"] = invocations + slots
        control["last_consumed_seq"] = consumed_through
        control["last_parse_at"] = time.time()
        persist = {key: value for key, value in control.items() if not str(key).startswith("_")}
        write_summary_control(persist)
        control["_prompt_records"] = included
        control["_grok_proof_needed"] = proof_needed
        return control
    finally:
        lock.close()


def mark_grok_session_proven(expected_session: str) -> bool:
    lock = _lock_summary_state()
    try:
        control = read_summary_control()
        if control.get("session_id") != expected_session:
            return False
        control["grok_proven"] = True
        write_summary_control(control)
        return True
    finally:
        lock.close()


def run_one_parse(
    records: list[dict],
    expected_session: str | None = None,
    *,
    finishing: bool = False,
) -> str:
    agent = resolve_summary_agent()
    if not agent:
        return ""
    reserved = reserve_parse_invocation(
        records,
        expected_session,
        finishing=finishing,
        agent_id=agent,
    )
    if reserved is None:
        return ""
    session_id = reserved.get("session_id") or ""
    prompt_records = reserved.get("_prompt_records") or records
    prompt = build_summary_prompt(prompt_records)
    previous_session = getattr(_agent_invocation, "session_id", None)
    _agent_invocation.session_id = session_id
    try:
        try:
            grok_proven = bool(reserved.get("grok_proven"))
            if agent == "grok" and reserved.get("_grok_proof_needed"):
                prove_grok()
                if not mark_grok_session_proven(session_id):
                    raise SummaryAgentError("could not bind Grok proof to summary session")
                grok_proven = True
            if agent == "grok":
                raw = invoke_summary_agent(agent, prompt, grok_proven=grok_proven)
            else:
                raw = invoke_summary_agent(agent, prompt)
        except (SummaryAgentError, OSError, subprocess.TimeoutExpired, subprocess.SubprocessError):
            raw = ""
    finally:
        if previous_session is None:
            delattr(_agent_invocation, "session_id")
        else:
            _agent_invocation.session_id = previous_session
    if not raw:
        _mark_parse_failed(session_id)
        return ""
    if read_summary_control().get("session_id") != session_id:
        return ""
    publish_summary_result(raw, session_id)
    return raw


def _mark_parse_failed(expected_session: str | None = None) -> dict:
    lock = _lock_summary_state()
    try:
        control = read_summary_control()
        if expected_session and control.get("session_id") != expected_session:
            return control
        control["parse_failed"] = True
        write_summary_control(control)
        return control
    finally:
        lock.close()


def mark_lift_fail_pending(pending: bool = True) -> dict:
    lock = _lock_summary_state()
    try:
        control = read_summary_control()
        control["lift_fail_pending"] = bool(pending)
        write_summary_control(control)
        return control
    finally:
        lock.close()


def apply_summary_xor() -> str:
    mark_lift_fail_pending(False)
    control = read_summary_control()
    result = read_summary_result()
    text = str(result.get("text") or "").strip()
    if (
        agent_summaries_enabled()
        and resolve_summary_agent()
        and text
        and result.get("session_id") == control.get("session_id")
    ):
        body = _truncate_bytes(text, PARSE_NOTIFY_BODY_MAX)
        if notify("Focus summary", body, timeout_ms=SUMMARY_NOTIFY_MS):
            clear_counts()
            result_path = summary_result_path()
            if result_path.exists():
                result_path.unlink()
            collect_summary_feedback()
            return "summary"
        show_grouped_notice()
        _discard_summary_result()
        return "grouped"
    if control.get("parse_failed"):
        notify("Focus mode", "Could not summarize blocked notifications.")
    show_grouped_notice()
    _discard_summary_result()
    return "grouped"


def _discard_summary_result() -> None:
    result_path = summary_result_path()
    if result_path.exists():
        result_path.unlink()


def summarize_finish(expected_session: str | None = None) -> dict:
    started = request_summary_finish(expected_session, reap=False)
    if expected_session and started.get("session_id") != expected_session:
        return started
    deadline = time.monotonic() + FINISH_WAIT_S
    guard = None
    while time.monotonic() < deadline:
        guard = try_summarize_session_lock()
        if guard is not None:
            break
        time.sleep(0.2)
    if guard is None:
        reap_summary_children()
        guard = try_summarize_session_lock()
    try:
        control = read_summary_control()
        if expected_session and control.get("session_id") != expected_session:
            return control
        session_id = expected_session or control.get("session_id")
        unseen = observe_ping_records(int(control.get("last_consumed_seq") or 0))
        if (
            guard is not None
            and unseen
            and int(control.get("invocations") or 0) < PARSE_MAX_INVOCATIONS
            and int(control.get("parser_restarts") or 0) < PARSER_RESTART_MAX
        ):
            run_one_parse(unseen, session_id, finishing=True)
        request_summary_finish(session_id, reap=True)
        return read_summary_control()
    finally:
        if guard is not None:
            guard.close()


def cmd_summarize_finish() -> None:
    session = None
    args = sys.argv[2:]
    if "--session" in args:
        index = args.index("--session")
        if index + 1 < len(args):
            session = args[index + 1]
    summarize_finish(session)


def run_summarize_session(
    *,
    restart: bool = False,
    once: bool = False,
    expected_session: str | None = None,
) -> int:
    guard = try_summarize_session_lock()
    if guard is None:
        return SESSION_BUSY_EXIT
    try:
        if restart:
            if apply_parser_restart(expected_session) is None:
                return 0
        else:
            try:
                mark_parser_active(expected_session)
            except ValueError:
                return 0
        child: threading.Thread | None = None
        while True:
            control = read_summary_control()
            if not _session_matches(control, expected_session) or should_stop_parser(control):
                if child is not None and child.is_alive():
                    child.join(timeout=FINISH_WAIT_S)
                clear_parser_running(expected_session)
                return 0
            last_seen = int(control.get("last_consumed_seq") or 0)
            unseen = observe_ping_records(last_seen)
            last_parse_at = float(control.get("last_parse_at") or 0)
            debounce_ok = last_parse_at == 0.0 or (time.time() - last_parse_at) >= PARSE_DEBOUNCE_S
            if unseen and child is None and not once and debounce_ok:
                child = threading.Thread(
                    target=run_one_parse,
                    args=(list(unseen), expected_session),
                    kwargs={"finishing": False},
                    daemon=True,
                )
                child.start()
            if child is not None and not child.is_alive():
                child = None
            if once:
                return 0
            time.sleep(PARSER_POLL_S)
    finally:
        guard.close()


def cmd_summarize_session() -> None:
    args = sys.argv[2:]
    restart = "--restart" in args
    session = None
    if "--session" in args:
        index = args.index("--session")
        if index + 1 < len(args):
            session = args[index + 1]
    code = run_summarize_session(
        restart=restart,
        once=os.environ.get("DISTRACTIONS_SUMMARY_ONCE") == "1",
        expected_session=session,
    )
    if code:
        raise SystemExit(code)


def count_path() -> Path:
    return STATE_DIR / "distractions.notify-count.json"


def count_lock_path() -> Path:
    return STATE_DIR / "distractions.notify-count.lock"


def _lock_count():
    path = count_lock_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    handle = open(path, "w")
    fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
    return handle


def read_counts() -> dict[str, int]:
    data = read_json(count_path(), {})
    if not isinstance(data, dict):
        return {}
    counts: dict[str, int] = {}
    for key, value in data.items():
        try:
            number = int(value)
        except (TypeError, ValueError):
            continue
        if number > 0:
            counts[str(key)] = number
    return counts


def write_counts_atomic(counts: dict[str, int]) -> None:
    path = count_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    with tmp.open("w", encoding="utf-8") as handle:
        handle.write(json.dumps(counts, sort_keys=True) + "\n")
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(tmp, path)


def increment_count(label: str) -> None:
    name = str(label or "").strip()
    if not name:
        raise SystemExit("count-increment requires a label")
    lock = _lock_count()
    try:
        counts = read_counts()
        counts[name] = counts.get(name, 0) + 1
        write_counts_atomic(counts)
    finally:
        lock.close()


def format_grouped_notice(counts: dict[str, int]) -> tuple[str, str]:
    lines = [f"{label} {counts[label]}" for label in sorted(counts) if counts[label] > 0]
    return "While you were focused", "\n".join(lines)


def clear_counts() -> None:
    lock = _lock_count()
    try:
        path = count_path()
        if path.exists():
            path.unlink()
    finally:
        lock.close()


def show_grouped_notice() -> bool:
    return send_catchup_notice()


def send_catchup_notice() -> bool:
    lock = _lock_count()
    try:
        counts = read_counts()
        if not counts:
            return True
        title, body = format_grouped_notice(counts)
        if not notify(title, body, timeout_ms=8000):
            return False
        path = count_path()
        if path.exists():
            path.unlink()
        return True
    finally:
        lock.close()


def muted_ids() -> list[int]:
    data = read_json(MUTED_PATH, [])
    if not isinstance(data, list):
        raise RuntimeError("muted sink-input snapshot is invalid")
    try:
        return [int(item) for item in data]
    except (TypeError, ValueError) as exc:
        raise RuntimeError("muted sink-input snapshot is invalid") from exc


def save_muted_ids(ids: list[int]) -> None:
    write_json_atomic(MUTED_PATH, ids)


def shell_ipc(*args: str, timeout: float = 4.0) -> tuple[int, str]:
    try:
        result = subprocess.run(
            [SHELL_BIN, *args],
            capture_output=True,
            text=True,
            timeout=timeout,
            check=False,
        )
    except FileNotFoundError:
        return 127, "omarchy-shell is missing"
    except subprocess.TimeoutExpired:
        return 124, "omarchy-shell timed out"
    return result.returncode, (result.stdout or "").strip()


def which_cmd(name: str) -> bool:
    from shutil import which

    return which(name) is not None


def notification_daemon_ok() -> tuple[bool, str]:
    if not which_cmd(SHELL_BIN) and SHELL_BIN == "omarchy-shell":
        return False, "omarchy-shell is missing"
    code, out = shell_ipc("notifications", "dndState", timeout=3.0)
    if code != 0:
        return False, "Quickshell NotificationServer is not reachable"
    lowered = out.lower()
    if "mako" in lowered:
        return False, "notification daemon is still mako"
    return True, out


def plugin_ping() -> str:
    code, out = shell_ipc(PLUGIN_IPC, "ping", timeout=3.0)
    if code != 0:
        return ""
    return out.splitlines()[0] if out else ""


def wait_plugin_ready(timeout: float | None = None) -> bool:
    deadline = time.monotonic() + (APPLY_WAIT_S if timeout is None else timeout)
    while time.monotonic() < deadline:
        if plugin_ping() == "ready":
            return True
        time.sleep(0.2)
    return False


def plugin_call(method: str) -> tuple[int, str]:
    return shell_ipc(PLUGIN_IPC, method, timeout=3.0)


def read_watcher_request() -> dict:
    data = read_json(WATCHER_REQUEST, {})
    if not isinstance(data, dict):
        return {"generation": 0, "want_armed": False, "keep_muted": []}
    return {
        "generation": parse_int(data.get("generation"), 0),
        "want_armed": bool(data.get("want_armed")),
        "keep_muted": parse_int_list(data.get("keep_muted") or []),
    }


def next_generation(current: int | None = None) -> int:
    if current is not None:
        return parse_int(current, 0) + 1
    return read_watcher_request()["generation"] + 1


def write_watcher_request(generation: int, want_armed: bool, keep_muted: list[int] | None = None) -> None:
    payload = {"generation": parse_int(generation, 0), "want_armed": bool(want_armed)}
    if keep_muted is not None:
        payload["keep_muted"] = parse_int_list(keep_muted)
    write_json_atomic(WATCHER_REQUEST, payload)


def read_watcher_status() -> dict:
    data = read_json(WATCHER_STATUS, {})
    return data if isinstance(data, dict) else {}


def listener_stamp(pid: int | None = None) -> dict:
    current = os.getpid() if pid is None else pid
    return {"pid": current, "starttime": read_proc_starttime(current) or ""}


def write_watcher_status(payload: dict) -> None:
    data = dict(payload)
    pid = parse_int(data.get("pid"), 0)
    if pid <= 0:
        data.update(listener_stamp())
    elif "starttime" not in data and pid == os.getpid():
        data["starttime"] = read_proc_starttime(pid) or ""
    write_json_atomic(WATCHER_STATUS, data)


def persist_then_ack_status(generation: int, armed: bool, last_error: str, muted: list[int]) -> tuple[bool, str]:
    try:
        save_muted_ids(muted)
    except OSError as exc:
        error = str(exc) or "failed to persist muted sink-inputs"
        write_watcher_status(
            {
                **listener_stamp(),
                "generation": generation,
                "armed": False,
                "last_error": error,
                "muted": muted,
            }
        )
        return False, error
    write_watcher_status(
        {
            **listener_stamp(),
            "generation": generation,
            "armed": armed,
            "last_error": last_error,
            "muted": muted,
        }
    )
    return armed, last_error


def watcher_pid_live(status: dict) -> bool:
    try:
        pid = int(status.get("pid") or 0)
    except (TypeError, ValueError):
        return False
    recorded = str(status.get("starttime") or "")
    if pid <= 0 or not recorded:
        return False
    live = read_proc_starttime(pid)
    return live is not None and live == recorded


def watcher_acknowledged_armed(status: dict | None = None) -> bool:
    last = status if isinstance(status, dict) else read_watcher_status()
    return bool(last.get("armed")) and watcher_pid_live(last)


def watcher_desired_armed(request: dict | None = None) -> bool:
    data = request if isinstance(request, dict) else read_watcher_request()
    return bool(data.get("want_armed")) and is_focus()


def watcher_needs_transition(generation: int, armed: bool, request: dict) -> bool:
    want_gen = parse_int(request.get("generation"), 0)
    want_armed = watcher_desired_armed(request)
    return bool(want_gen and want_gen != generation) or (bool(armed) != bool(want_armed))


def wait_watcher_ack(generation: int, want_armed: bool, timeout: float | None = None) -> tuple[bool, str]:
    deadline = time.monotonic() + (APPLY_WAIT_S if timeout is None else timeout)
    last = {}
    while time.monotonic() < deadline:
        last = read_watcher_status()
        if not watcher_pid_live(last):
            time.sleep(0.2)
            continue
        if parse_int(last.get("generation"), 0) == generation:
            error = str(last.get("last_error") or "")
            if error:
                return False, error
            if bool(last.get("armed")) == bool(want_armed):
                return True, ""
        time.sleep(0.2)
    if not watcher_pid_live(last):
        return False, "notification stream watcher is not running"
    return False, str(last.get("last_error") or "watcher acknowledgement timed out")


def _lock_notify():
    handle = open(NOTIFY_LOCK, "w")
    fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
    return handle


def apply_notification_block() -> bool:
    lock = _lock_notify()
    try:
        return _apply_notification_block()
    finally:
        lock.close()


def lift_notification_block(*, catchup: bool = True) -> bool:
    lock = _lock_notify()
    try:
        return _lift_notification_block(catchup=catchup)
    finally:
        lock.close()


def sink_exists(index: int) -> bool:
    try:
        return any(sink_index(entry) == index for entry in list_sink_inputs())
    except Exception:
        return True


def unmute_owned(ids: list[int]) -> list[int]:
    leftover: list[int] = []
    for index in ids:
        if pactl_mute(index, False):
            continue
        if sink_exists(index):
            leftover.append(index)
    return leftover


def restore_owned_after_failed_arm(
    current_muted: list[int],
    previously_owned: list[int],
) -> list[int]:
    owned = set(previously_owned)
    extras = [item for item in current_muted if item not in owned]
    leftover = unmute_owned(extras)
    restored = list(previously_owned)
    for item in leftover:
        if item not in restored:
            restored.append(item)
    return restored


def arm_sink_transition(
    members: list[dict],
    muted: list[int],
    was_armed: bool,
) -> tuple[set[int], list[int], str, bool]:
    previously_owned = list(muted)
    seen, muted, last_error = evaluate_sink_inputs(True, members, set(), muted)
    if last_error:
        muted = restore_owned_after_failed_arm(muted, previously_owned)
        return seen, muted, last_error, was_armed
    return seen, muted, "", True


def _apply_notification_block() -> bool:
    if not is_focus():
        return True
    snapshot_muted: list[int] = []
    was_armed = False
    generation = 0
    try:
        was_armed = watcher_acknowledged_armed()
        snapshot_muted = muted_ids()
        generation = next_generation()
        members_match_windows()
        load_members()
        ok, reason = notification_daemon_ok()
        if not ok:
            raise RuntimeError(reason)
        write_watcher_request(generation, True)
        ack_ok, ack_err = wait_watcher_ack(generation, True)
        if not ack_ok:
            raise RuntimeError(ack_err)
        if not wait_plugin_ready():
            raise RuntimeError(
                "notification filter is not ready; reload or reinstall the plugin"
            )
        code, out = plugin_call("arm")
        if code != 0 or out not in {"ok", "ready"}:
            raise RuntimeError(out or "failed to arm the notification filter")
        return True
    except Exception as exc:
        _rollback_apply(snapshot_muted, generation, was_armed)
        notify(
            "Focus mode",
            f"Could not mute distraction notifications. {exc}",
        )
        return False


def _lift_notification_block(*, catchup: bool = True) -> bool:
    generation = next_generation()
    try:
        code, out = plugin_call("disarm")
        if code != 0 and "missing" not in (out or "").lower():
            raise RuntimeError(out or "failed to disarm the notification filter")
        write_watcher_request(generation, False)
        ack_ok, ack_err = wait_watcher_ack(generation, False)
        if not ack_ok:
            raise RuntimeError(ack_err)
        deadline = time.monotonic() + APPLY_WAIT_S
        drained = out == "drained"
        while time.monotonic() < deadline:
            drain_code, drain_out = plugin_call("drainState")
            if drain_code != 0:
                raise RuntimeError(drain_out or "failed to read notification filter drain state")
            if drain_out == "error":
                raise RuntimeError("notification count increment failed")
            if drain_out == "drained":
                drained = True
                break
            time.sleep(0.2)
        if not drained:
            raise RuntimeError("notification filter did not drain")
        if catchup:
            send_catchup_notice()
        return True
    except Exception as exc:
        notify(
            "Focus mode",
            f"Could not restore distraction notifications. {exc}",
        )
        return False


def _rollback_apply(
    snapshot_muted: list[int],
    failed_generation: int,
    was_armed: bool,
) -> None:
    try:
        rollback_gen = max(parse_int(failed_generation, 0) + 1, next_generation())
        if was_armed:
            plugin_call("arm")
            write_watcher_request(rollback_gen, True)
            wait_watcher_ack(rollback_gen, True, timeout=3.0)
            status = read_watcher_status()
            save_muted_ids(parse_int_list(status.get("muted")))
            return
        plugin_call("disarm")
        write_watcher_request(rollback_gen, False, keep_muted=snapshot_muted)
        wait_watcher_ack(rollback_gen, False, timeout=3.0)
        try:
            current = muted_ids()
        except RuntimeError:
            current = list(snapshot_muted)
        save_muted_ids(restore_owned_after_failed_arm(current, snapshot_muted))
    except Exception:
        try:
            write_watcher_request(parse_int(failed_generation, 0) + 1, False, keep_muted=snapshot_muted)
        except Exception:
            pass


def pactl(*args: str, timeout: float = 4.0) -> tuple[int, str]:
    try:
        result = subprocess.run(
            [PACTL_BIN, *args],
            capture_output=True,
            text=True,
            timeout=timeout,
            check=False,
        )
    except FileNotFoundError:
        return 127, "pactl is missing"
    except subprocess.TimeoutExpired:
        return 124, "pactl timed out"
    return result.returncode, (result.stdout or "").strip()


def pactl_mute(index: int, muted: bool) -> bool:
    code, _out = pactl("set-sink-input-mute", str(index), "1" if muted else "0")
    return code == 0


def list_sink_inputs() -> list[dict]:
    code, out = pactl("--format=json", "list", "sink-inputs")
    if code != 0:
        raise RuntimeError(out or "pactl list sink-inputs failed")
    data = json.loads(out or "[]")
    if not isinstance(data, list):
        raise RuntimeError("pactl list sink-inputs returned invalid JSON")
    return data


def read_proc_starttime(pid: int) -> str | None:
    try:
        stat = Path(f"/proc/{pid}/stat").read_text()
    except OSError:
        return None
    close = stat.rfind(")")
    if close < 0:
        return None
    fields = stat[close + 2 :].split()
    if len(fields) < 20:
        return None
    return fields[19]


def read_proc_ppid(pid: int) -> int | None:
    try:
        stat = Path(f"/proc/{pid}/stat").read_text()
    except OSError:
        return None
    close = stat.rfind(")")
    if close < 0:
        return None
    fields = stat[close + 2 :].split()
    if len(fields) < 2:
        return None
    try:
        return int(fields[1])
    except ValueError:
        return None


def read_proc_cmdline(pid: int) -> str | None:
    try:
        raw = Path(f"/proc/{pid}/cmdline").read_bytes()
    except OSError:
        return None
    return raw.replace(b"\x00", b" ").decode("utf-8", "replace")


def walk_process_cmdlines(pid: int, depth: int = PROC_WALK_DEPTH) -> list[str]:
    chain: list[str] = []
    seen: set[int] = set()
    current = pid
    for _ in range(depth):
        if current <= 1 or current in seen:
            break
        seen.add(current)
        start = read_proc_starttime(current)
        cmdline = read_proc_cmdline(current)
        again = read_proc_starttime(current)
        if not start or start != again or cmdline is None:
            break
        chain.append(cmdline)
        parent = read_proc_ppid(current)
        if parent is None:
            break
        current = parent
    return chain


def sink_properties(entry: dict) -> dict:
    props = entry.get("properties") or entry.get("property_list") or {}
    if not isinstance(props, dict):
        return {}
    return {str(key): str(value) for key, value in props.items()}


def sink_index(entry: dict) -> int | None:
    for key in ("index", "sink_input_index"):
        if key in entry:
            try:
                return int(entry[key])
            except (TypeError, ValueError):
                return None
    return None


def sink_is_muted(entry: dict) -> bool:
    for key in ("mute", "muted"):
        if key not in entry:
            continue
        value = entry[key]
        if isinstance(value, bool):
            return value
        if isinstance(value, (int, float)):
            return bool(value)
        text = str(value).strip().lower()
        if text in {"1", "true", "yes", "on", "muted"}:
            return True
        if text in {"0", "false", "no", "off", "unmuted"}:
            return False
    return False


def evaluate_sink_inputs(armed: bool, members: list[dict], seen: set[int], muted: list[int]) -> tuple[set[int], list[int], str]:
    try:
        entries = list_sink_inputs()
    except Exception as exc:
        return seen, muted, str(exc)
    current_ids = set()
    owned = set(muted)
    for entry in entries:
        index = sink_index(entry)
        if index is None:
            continue
        current_ids.add(index)
        if not armed:
            continue
        props = sink_properties(entry)
        pid_raw = props.get("application.process.id") or props.get("application.process.id".replace(".", "_"))
        try:
            pid = int(pid_raw) if pid_raw else 0
        except ValueError:
            pid = 0
        chain = walk_process_cmdlines(pid) if pid else []
        if not match_stream(props, chain, members):
            seen.add(index)
            continue
        already_muted = sink_is_muted(entry)
        if index in owned:
            if not already_muted and not pactl_mute(index, True):
                return seen, muted, f"failed to mute sink-input {index}"
            seen.add(index)
            continue
        if already_muted:
            seen.add(index)
            continue
        if not pactl_mute(index, True):
            return seen, muted, f"failed to mute sink-input {index}"
        muted.append(index)
        owned.add(index)
        seen.add(index)
    muted = [item for item in muted if item in current_ids]
    seen = {item for item in seen if item in current_ids}
    return seen, muted, ""


def start_stream_watcher() -> None:
    global _watcher_thread
    if _watcher_thread and _watcher_thread.is_alive():
        return
    _watcher_stop.clear()
    _watcher_thread = threading.Thread(target=_watcher_main, name="distractions-pactl", daemon=True)
    _watcher_thread.start()


def _watcher_main() -> None:
    members: list[dict] = []
    try:
        members = load_members()
        members_match_windows()
        muted = muted_ids()
    except Exception as exc:
        write_watcher_status(
            {**listener_stamp(), "generation": 0, "armed": False, "last_error": str(exc), "muted": []}
        )
        return
    seen: set[int] = set(muted)
    armed = False
    generation = 0
    last_error = ""
    proc = None
    try:
        proc = subprocess.Popen(
            [PACTL_BIN, "subscribe"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
        )
    except FileNotFoundError:
        write_watcher_status(
            {
                **listener_stamp(),
                "generation": generation,
                "armed": False,
                "last_error": "pactl is missing",
                "muted": muted,
            }
        )
        return

    def publish() -> None:
        nonlocal armed, last_error
        armed, last_error = persist_then_ack_status(generation, armed, last_error, muted)

    publish()
    assert proc.stdout is not None
    while not _watcher_stop.is_set():
        request = read_watcher_request()
        want_gen = request["generation"]
        want_armed = watcher_desired_armed(request)
        keep_muted = set(request["keep_muted"])
        if watcher_needs_transition(generation, armed, request):
            if want_gen:
                generation = want_gen
            last_error = ""
            if want_armed:
                seen, muted, last_error, armed = arm_sink_transition(members, muted, armed)
            else:
                release = [item for item in muted if item not in keep_muted]
                leftovers = unmute_owned(release)
                muted = leftovers + [item for item in muted if item in keep_muted]
                seen = set(muted)
                armed = False
                if leftovers:
                    last_error = "failed to unmute snapshotted sink-inputs"
            publish()
        if proc.poll() is not None:
            last_error = "pactl subscribe exited"
            armed = False
            publish()
            break
        ready, _, _ = select.select([proc.stdout], [], [], 0.2)
        if not ready:
            continue
        line = proc.stdout.readline()
        if not line:
            continue
        event = SINK_EVENT_RE.search(line)
        if not event:
            continue
        kind = event.group(1)
        removed = int(event.group(2)) if event.group(2) else None
        if kind == "remove" and removed is not None:
            muted = [item for item in muted if item != removed]
            seen.discard(removed)
            publish()
            continue
        if armed and is_focus():
            seen, muted, last_error = evaluate_sink_inputs(True, members, seen, muted)
            if last_error:
                armed = False
            publish()
    if proc.poll() is None:
        proc.terminate()
        try:
            proc.wait(timeout=1)
        except subprocess.TimeoutExpired:
            proc.kill()


def install_notification_service() -> bool:
    code, out = shell_ipc("shell", "rescanPlugins", timeout=8.0)
    if code != 0:
        notify("Focus mode", out or "Could not reload the notification filter plugin.")
        return False
    if wait_plugin_ready():
        return True
    notify(
        "Focus mode",
        "Notification filter did not become ready after install; reload the plugin.",
    )
    return False


def refresh_focus_notification_block() -> bool:
    if not is_focus():
        return False
    if not apply_notification_block():
        return False
    publish_summary_after_mute()
    return True


def enable_focus() -> None:
    lock = _lock_focus_transition()
    try:
        prepare_summary_session()
        with focus_block.network_lock():
            try:
                apply_network_block()
            except focus_block.BlockError:
                return
            set_focus(True)
            if on_distractions():
                hide()
        refresh_focus_notification_block()
        notify("Focus mode on", "The distraction space is locked. Super+D will not open it.")
    finally:
        lock.close()


def disable_focus(reason: str) -> None:
    reason = " ".join(reason.split())
    if len(reason) < MIN_REASON:
        raise SystemExit(
            f"reason must be at least {MIN_REASON} characters (got {len(reason)})"
        )
    lock = _lock_focus_transition()
    try:
        _disable_focus_locked(reason)
    finally:
        lock.close()


def _disable_focus_locked(reason: str) -> None:
    stamp = datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds")
    with log_path().open("a", encoding="utf-8") as handle:
        handle.write(f"{stamp}  {reason}\n")
    summaries_on = agent_summaries_enabled()
    leaving_session = read_summary_control().get("session_id") or ""
    lift_fail_pending = bool(read_summary_control().get("lift_fail_pending"))
    with focus_block.network_lock():
        set_focus(False)
        if not summaries_on:
            try:
                lift_network_block()
            except focus_block.BlockError:
                pass
    if summaries_on:
        summarize_finish(leaving_session or None)
        if is_focus() or (
            leaving_session
            and read_summary_control().get("session_id") != leaving_session
        ):
            return
        if lift_notification_block(catchup=False):
            apply_summary_xor()
        else:
            mark_lift_fail_pending()
        with focus_block.network_lock():
            try:
                lift_network_block()
            except focus_block.BlockError:
                pass
    elif lift_fail_pending:
        request_summary_finish(leaving_session or None)
        if is_focus() or (
            leaving_session
            and read_summary_control().get("session_id") != leaving_session
        ):
            return
        if lift_notification_block(catchup=False):
            apply_summary_xor()
        else:
            mark_lift_fail_pending()
    else:
        request_summary_finish(leaving_session or None)
        lift_notification_block()
    notify("Focus mode off", "Super+D opens the distraction space.")


def prompt_reason() -> str | None:
    try:
        result = subprocess.run(
            [
                "zenity",
                "--entry",
                "--title=Leave focus mode",
                "--text=Write at least 50 characters on why you are leaving focus mode.",
                "--width=520",
                "--ok-label=Turn off",
                "--cancel-label=Stay focused",
            ],
            capture_output=True,
            text=True,
            check=False,
        )
    except FileNotFoundError:
        notify("Focus mode", "zenity is missing; cannot ask for a reason.")
        return None
    if result.returncode != 0:
        return None
    return result.stdout.strip()


def request_focus_toggle() -> None:
    if not is_focus():
        enable_focus()
        return
    reason = prompt_reason()
    if reason is None:
        return
    try:
        disable_focus(reason)
    except SystemExit as exc:
        notify("Focus mode", str(exc))


def listen() -> None:
    ensure_focus_default()
    pin_id()
    runtime = Path(os.environ["XDG_RUNTIME_DIR"])
    signature = os.environ["HYPRLAND_INSTANCE_SIGNATURE"]
    sock_path = runtime / "hypr" / signature / ".socket2.sock"

    lock = open(LISTEN_LOCK, "w")
    try:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return

    start_stream_watcher()
    with focus_block.network_lock():
        if is_focus() and on_distractions():
            hide()
        if is_focus():
            try:
                apply_network_block()
            except focus_block.BlockError:
                pass
    if is_focus():
        refresh_focus_notification_block()
        if on_distractions():
            hide()
    else:
        write_watcher_request(next_generation(), False)

    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.connect(str(sock_path))
    with sock.makefile("r") as events:
        for _line in events:
            if is_focus():
                refresh_focus_notification_block()
                if on_distractions():
                    hide()


def main() -> None:
    command = sys.argv[1] if len(sys.argv) > 1 else "toggle"
    if command == "toggle":
        toggle()
    elif command == "enter":
        enter()
    elif command == "next":
        cycle(1)
    elif command == "prev":
        cycle(-1)
    elif command == "listen":
        listen()
    elif command in {"focus", "focus-toggle"}:
        request_focus_toggle()
    elif command == "focus-on":
        if not is_focus():
            enable_focus()
    elif command == "focus-off":
        reason = " ".join(sys.argv[2:]).strip()
        if not reason and not sys.stdin.isatty():
            reason = sys.stdin.read().strip()
        disable_focus(reason)
    elif command == "focus-status":
        raise SystemExit(0 if is_focus() else 1)
    elif command == "agent-summaries":
        cmd_agent_summaries()
    elif command == "summary-agent":
        cmd_summary_agent()
    elif command == "capture-ping":
        cmd_capture_ping()
    elif command == "summarize-session":
        cmd_summarize_session()
    elif command == "summarize-finish":
        cmd_summarize_finish()
    elif command == "log-path":
        print(log_path())
    elif command == "destinations":
        warnings: list[str] = []
        for name in focus_block.active_names(warnings=warnings):
            print(name)
        for warning in warnings:
            notify("Focus mode", warning)
    elif command == "destinations-add":
        name = " ".join(sys.argv[2:]).strip()
        if not name:
            raise SystemExit("usage: distractions destinations-add <name-or-host>")
        try:
            with focus_block.network_lock():
                previous = focus_block.load_config()
                added = focus_block.add_destination(name)
                if is_focus():
                    try:
                        apply_network_block()
                    except focus_block.BlockError:
                        focus_block.write_config(previous)
                        raise
        except focus_block.BlockError as exc:
            notify("Focus mode", str(exc))
            raise SystemExit(str(exc))
        print(added)
    elif command == "destinations-remove":
        name = " ".join(sys.argv[2:]).strip()
        if not name:
            raise SystemExit("usage: distractions destinations-remove <name-or-host>")
        try:
            with focus_block.network_lock():
                previous = focus_block.load_config()
                removed = focus_block.remove_destination(name)
                if is_focus():
                    try:
                        apply_network_block()
                    except focus_block.BlockError:
                        focus_block.write_config(previous)
                        raise
        except focus_block.BlockError as exc:
            notify("Focus mode", str(exc))
            raise SystemExit(str(exc))
        print(removed)
    elif command == "count-increment":
        increment_count(" ".join(sys.argv[2:]).strip())
    elif command in {"install", "install-notifications"}:
        raise SystemExit(0 if install_notification_service() else 1)
    else:
        raise SystemExit(f"unknown command: {command}")


if __name__ == "__main__":
    main()

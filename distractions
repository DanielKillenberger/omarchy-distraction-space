def load_members(path: Path | None = None) -> list[dict]:
    data = json.loads((path or MEMBERS_PATH).read_text())
    members = data.get("members") if isinstance(data, dict) else None
    if not isinstance(members, list) or not members:
        raise ValueError("notification-members.json has no members")
    for member in members:
        _reject_generic_member(member)
    return members


def _reject_generic_member(member: dict) -> None:
    native = member.get("native") or {}
    for key in ("app", "appIcon", "pulseName", "pulseBinary"):
        for value in native.get(key) or []:
            if normalize_token(value) in GENERIC_BROWSER:
                raise ValueError(
                    f"member {member.get('label')!r} uses generic browser identity {value!r}"
                )



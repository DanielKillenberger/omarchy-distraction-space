LISTEN_LOCK = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "distractions.listen.lock"
NOTIFY_LOCK = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "distractions.notify.lock"
WATCHER_REQUEST = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "distractions.notify.request"
WATCHER_STATUS = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "distractions.notify.status"
DEFAULT_LOG = STATE_DIR / "focus-disable.log"

#!/usr/bin/env python3
"""CLI entry for the distraction space plugin."""

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from ds import catalog, config, hold, hypr, launch, listener, lock, profile, setup, state, ui

COMMANDS = {
    "status": state.cmd_status,
    "list": config.cmd_list,
    "config": config.cmd_config,
    "catalog": catalog.cmd_catalog,
    "lock": lock.cmd_lock,
    "unlock": lock.cmd_unlock,
    "enter": lock.cmd_enter,
    "leave": lock.cmd_leave,
    "toggle": lock.cmd_toggle,
    "next": hypr.cmd_next,
    "prev": hypr.cmd_prev,
    "menu": ui.cmd_menu,
    "listen": listener.cmd_listen,
    "reload": listener.cmd_reload,
    "refresh": listener.cmd_refresh,
    "release": listener.cmd_release,
    "setup": setup.cmd_setup,
    "senders": hold.cmd_senders,
    "banners": state.cmd_banners,
    "profile": profile.cmd_profile,
}


def positive_int(value):
    try:
        n = int(value)
    except ValueError:
        n = 0
    if n < 1:
        raise argparse.ArgumentTypeError(f"{value!r} is not a positive integer")
    return n


def release_minutes(value):
    n = positive_int(value)
    if n > config.RELEASE_MAX_MINUTES:
        raise argparse.ArgumentTypeError(f"{value!r} is over the {config.RELEASE_MAX_MINUTES} minute limit")
    return n


def build_parser():
    p = argparse.ArgumentParser(prog="distractions")
    sub = p.add_subparsers(dest="command")
    sub.add_parser("status").add_argument("--json", action="store_true")
    ls = sub.add_parser("list").add_subparsers(dest="list_cmd")
    ls.add_parser("add").add_argument("entry")
    ls.add_parser("remove").add_argument("name")
    ls.add_parser("expand")
    cs = sub.add_parser("config").add_subparsers(dest="config_cmd")
    cs.add_parser("path")
    cs.add_parser("get").add_argument("key")
    s = cs.add_parser("set")
    s.add_argument("key")
    s.add_argument("value")
    cs.add_parser("edit")
    sub.add_parser("catalog")
    lk = sub.add_parser("lock")
    lk.add_argument("duration", nargs="?")
    lk.add_argument("purpose", nargs="*")
    sub.add_parser("unlock").add_argument("reason", nargs="*")
    for name in ("enter", "leave", "toggle", "next", "prev", "menu", "listen", "reload", "refresh"):
        sub.add_parser(name)
    sub.add_parser("release").add_argument("minutes", nargs="?", type=release_minutes)
    st = sub.add_parser("setup")
    st.add_argument("--remove", action="store_true")
    st.add_argument("--yes", action="store_true", help="answer the link question with the config value (true by default) instead of asking")
    sub.add_parser("senders")
    banners = sub.add_parser("banners")
    banners.add_argument("--count", type=positive_int, default=20, metavar="N")
    # Help only: `main` hands `open`'s tail to `launch.open_target` unparsed, since
    # every other -token is a browser flag argparse would read as its own.
    op = sub.add_parser(
        "open",
        usage="%(prog)s [--app] [target] [browser flags...]",
        description="Open a listed site or app in the distraction space; forward anything else to the previous browser. "
                    "Other -flags (--incognito, --private-window, ...) pass through to the forwarded browser unchanged, "
                    "in order; a flag that takes a value wants --flag=value.",
    )
    op.add_argument("--app", action="store_true", help="forward an unlisted URL as an app window (--app=<url>)")
    op.add_argument("target", nargs="?", help="an http(s) URL, a list entry, or a catalog name; none forwards the bare browser")
    pr = sub.add_parser("profile").add_subparsers(dest="profile_cmd")
    imp = pr.add_parser("import", help="copy the existing browser profile into the distraction profile once")
    imp.add_argument("--from", dest="source", metavar="PROFILE_DIR", help="a Chromium profile directory instead of the default browser's main profile")
    imp.add_argument("--replace", action="store_true", help="move an existing distraction profile aside to a dated backup first")
    return p


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv or (argv[0].startswith("-") and argv[0] not in ("-h", "--help")):
        # Omarchy's browser keybind runs the default browser's Exec first token
        # alone, with nothing or a private-window flag: the bare binary is `open`.
        argv.insert(0, "open")
    parser = build_parser()
    if argv[0] == "open":
        if any(a in ("-h", "--help") for a in argv[1:]):
            parser.parse_args(["open", "--help"])
        sys.exit(launch.open_target(argv[1:]))
    args = parser.parse_args(argv)
    try:
        rc = COMMANDS[args.command](args)
    except NotImplementedError:
        print("not yet", file=sys.stderr)
        sys.exit(2)
    sys.exit(rc if rc is not None else 0)


if __name__ == "__main__":
    main()

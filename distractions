def apply_enforcement(expanded: list[dict], *, mutate_rules: bool) -> bool:
    global _active_expand
    if not mutate_rules:
        ok = apply_named_rules(expanded, disable_removed=False)
        with _state_lock:
            _active_expand = expanded
        return ok
    if not apply_named_rules(expanded):
        fallback = load_last_good_expand()
        with _state_lock:
            _active_expand = fallback
        return False
    with _state_lock:
        _active_expand = expanded
    save_last_good_expand(expanded)
    return True


def bootstrap_enforcement() -> None:
    global _last_on_space
    _last_on_space = None
    ensure_net_worker()
    status, expanded = load_for_enforcement()
    apply_enforcement(expanded, mutate_rules=(status == "ok"))
    scan_existing_clients(notify_banner=False)
    if status == "corrupt" and not expanded:
        return
    sync_network_to_workspace()


def handle_reload_conn(conn: socket.socket) -> None:
    global _last_on_space
    try:
        conn.recv(1024)
        status, expanded = load_for_enforcement()
        if status == "corrupt":
            conn.sendall(b"error\n")
            return
        ensure_net_worker()
        _net.bump()
        if not apply_enforcement(expanded, mutate_rules=True):
            conn.sendall(b"error\n")
            return
        _last_on_space = None
        sync_network_to_workspace()
        if _net.wait_current_apply(_net.generation):
            conn.sendall(b"ok\n")
        else:
            conn.sendall(b"error\n")
    except OSError:
        try:
            conn.sendall(b"error\n")
        except OSError:
            pass
    finally:
        try:
            conn.close()
        except OSError:
            pass


def request_reload() -> bool:
    path = reload_sock_path()
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        sock.connect(str(path))
        sock.sendall(b"reload\n")
        reply = sock.recv(64)
        if reply.startswith(b"ok"):
            return True
        notify(
            "Distraction list",
            "The listener could not reload the list. Enforcement was left unchanged.",
        )
        return False
    except OSError:
        notify(
            "Distraction list",
            "The listener is not running. Enforcement was left unchanged.",
        )
        return False
    finally:
        sock.close()



def lookup_addresses(host: str) -> list[str]:
    infos = socket.getaddrinfo(host, None)
    return sorted({info[4][0] for info in infos if info[4]})


def resolve_host(host: str, timeout: float = DNS_TIMEOUT_S) -> list[str]:
    box: dict[str, list[str] | BaseException] = {}

    def lookup() -> None:
        try:
            box["addrs"] = lookup_addresses(host)
        except BaseException as exc:
            box["error"] = exc

    thread = threading.Thread(target=lookup, daemon=True)
    thread.start()
    thread.join(timeout)
    if thread.is_alive():
        raise TimeoutError(f"dns timeout: {host}")
    if "error" in box:
        raise box["error"]
    return list(box.get("addrs") or [])


def resolve_hosts(hosts: list[str], last_good: dict[str, list[str]]) -> dict[str, list[str]]:
    merged: dict[str, list[str]] = {}
    for host in hosts:
        addrs: list[str] = []
        try:
            addrs = resolve_host(host)
        except Exception:
            addrs = []
        previous = list(last_good.get(host) or [])
        if not addrs:
            if previous:
                merged[host] = previous
            continue
        merged[host] = sorted(set(addrs) | set(previous))
    return merged


def sudo_nft(command: str, stdin_text: str = "") -> int:
    try:
        proc = subprocess.run(
            ["sudo", "-n", NFT_WRAPPER, command, "ds"],
            input=stdin_text,
            text=True,
            capture_output=True,
            check=False,
        )
    except FileNotFoundError:
        note_network_unavailable()
        return 127
    if proc.returncode != 0:
        note_network_unavailable()
    return proc.returncode



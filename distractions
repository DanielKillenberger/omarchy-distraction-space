def class_matches(pattern: str, value: str) -> bool:
    if pattern.startswith("^"):
        return re.fullmatch(pattern, value) is not None
    return pattern == value


def _read_json_object(path: Path) -> dict | None:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        return None
    return data if isinstance(data, dict) else None


def load_rule_registry(path: Path) -> dict[str, dict]:
    raw = _read_json_object(path)
    if raw is None:
        return {}
    return {key: value for key, value in raw.items() if isinstance(key, str) and isinstance(value, dict)}


def save_rule_registry(path: Path, rows: dict[str, dict]) -> None:
    _atomic_write(path, json.dumps(rows, indent=2) + "\n")


def clear_rule_registry(path: Path) -> None:
    try:
        path.unlink()
    except FileNotFoundError:
        return


def load_addrs_last_good() -> dict[str, list[str]]:
    raw = _read_json_object(addrs_last_good_path())
    if raw is None:
        return {}
    out: dict[str, list[str]] = {}
    for host, addrs in raw.items():
        if isinstance(host, str) and isinstance(addrs, list):
            out[host] = [addr for addr in addrs if isinstance(addr, str) and addr]
    return out


def save_addrs_last_good(rows: dict[str, list[str]]) -> None:
    _atomic_write(addrs_last_good_path(), json.dumps(rows, indent=2) + "\n")


def desired_rule_map(expanded: list[dict]) -> dict[str, dict]:
    out: dict[str, dict] = {}
    for row in expanded:
        klass = row.get("class")
        name = row.get("name")
        if not klass or not isinstance(name, str):
            continue
        rule = window_rule_name(name)
        out[rule] = {
            "class": klass,
            "workspace": WORKSPACE_EFFECT,
            "enabled": True,
            "product": name,
        }
    return out


def set_named_rule(name: str, klass: str, workspace: str, enabled: bool) -> None:
    hyprctl("keyword", f"windowrule[{name}]:match:class {klass}")
    hyprctl("keyword", f"windowrule[{name}]:workspace {workspace}")
    hyprctl("keyword", f"windowrule[{name}]:enable {'true' if enabled else 'false'}")


def disable_named_rule(name: str) -> None:
    hyprctl("keyword", f"windowrule[{name}]:enable false")


def rollback_named_rule_batch(
    created: list[str],
    updated: list[str],
    last_good: dict[str, dict],
) -> None:
    for name in created:
        try:
            disable_named_rule(name)
        except (subprocess.CalledProcessError, FileNotFoundError):
            continue
    for name in updated:
        props = last_good.get(name) or {}
        try:
            set_named_rule(
                name,
                str(props.get("class") or ""),
                str(props.get("workspace") or WORKSPACE_EFFECT),
                bool(props.get("enabled", True)),
            )
        except (subprocess.CalledProcessError, FileNotFoundError):
            continue


def apply_named_rules(expanded: list[dict]) -> bool:
    desired = desired_rule_map(expanded)
    last_good = load_rule_registry(rules_last_good_path())
    old_pending = load_rule_registry(rules_pending_path())
    save_rule_registry(rules_pending_path(), desired)
    created: list[str] = []
    updated: list[str] = []
    try:
        for name, props in desired.items():
            if name in last_good:
                updated.append(name)
            else:
                created.append(name)
            set_named_rule(name, props["class"], props["workspace"], True)
    except (subprocess.CalledProcessError, FileNotFoundError):
        rollback_named_rule_batch(created, updated, last_good)
        notify(
            "Distraction list",
            "Window rules could not be updated and were rolled back.",
        )
        return False
    leftovers = (set(last_good) | set(old_pending)) - set(desired)
    failed_disable: list[str] = []
    for name in leftover_order(leftovers):
        try:
            disable_named_rule(name)
        except (subprocess.CalledProcessError, FileNotFoundError):
            failed_disable.append(name)
    if failed_disable:
        still = []
        for name in failed_disable:
            try:
                disable_named_rule(name)
            except (subprocess.CalledProcessError, FileNotFoundError):
                still.append(name)
        if still:
            notify(
                "Distraction list",
                "Some removed window rules could not be disabled and will be retried.",
            )
            merged = dict(desired)
            for name in still:
                merged[name] = last_good.get(name) or old_pending.get(name) or {
                    "enabled": True
                }
            save_rule_registry(rules_last_good_path(), merged)
            return True
    save_rule_registry(rules_last_good_path(), desired)
    clear_rule_registry(rules_pending_path())
    return True


def leftover_order(names: set[str]) -> list[str]:
    return sorted(names)


def load_for_enforcement() -> tuple[str, list[dict]]:
    raw = prepare_app_list()
    if raw is None:
        return "corrupt", load_last_good_expand()
    return "ok", expand_entries(raw)


def listed_hosts(expanded: list[dict] | None = None) -> list[str]:
    rows = _active_expand if expanded is None else expanded
    hosts: list[str] = []
    seen: set[str] = set()
    for row in rows:
        for host in row.get("hosts") or []:
            if host not in seen:
                seen.add(host)
                hosts.append(host)
    return hosts


def match_listed_client(client: dict) -> dict | None:
    klass = str(client.get("class") or "")
    for row in list(_active_expand):
        pattern = row.get("class")
        if isinstance(pattern, str) and pattern and class_matches(pattern, klass):
            return row
    return None


def client_on_space(client: dict) -> bool:
    workspace = client.get("workspace")
    if isinstance(workspace, dict):
        return is_distraction(workspace)
    return False


def norm_addr(address: str) -> str:
    value = address.strip().lower()
    if value.startswith("0x"):
        hex_part = value[2:].lstrip("0") or "0"
        return "0x" + hex_part
    return value


def client_by_address(address: str) -> dict | None:
    wanted = norm_addr(address)
    for client in hyprctl_json("clients"):
        if norm_addr(str(client.get("address") or "")) == wanted:
            return client
    return None


def silent_move(address: str) -> None:
    dispatch(f"movetoworkspacesilent {REF},address:{address}")


def maybe_banner(product: str) -> None:
    stamp = now()
    last = _banner_at.get(product, 0.0)
    if stamp - last < BANNER_DEBOUNCE_S:
        return
    _banner_at[product] = stamp
    notify(BANNER_TITLE, product)


def scan_existing_clients(*, notify_banner: bool) -> None:
    for client in hyprctl_json("clients"):
        row = match_listed_client(client)
        if row is None:
            continue
        if client_on_space(client):
            continue
        silent_move(str(client.get("address") or ""))
        if notify_banner:
            maybe_banner(str(row["name"]))


def handle_openwindow(address: str) -> None:
    client = client_by_address(address)
    if client is None:
        return
    row = match_listed_client(client)
    if row is None:
        return
    if not client_on_space(client):
        silent_move(str(client.get("address") or address))
    if on_distractions():
        return
    maybe_banner(str(row["name"]))


def handle_movewindow(address: str) -> None:
    client = client_by_address(address)
    if client is None:
        return
    row = match_listed_client(client)
    if row is None:
        return
    if client_on_space(client):
        return
    silent_move(str(client.get("address") or address))
    if on_distractions():
        return
    maybe_banner(str(row["name"]))


def process_socket2_line(line: str) -> None:
    text = line.strip()
    if not text:
        return
    event, _, payload = text.partition(">>")
    if event == "openwindow":
        handle_openwindow(payload.split(",", 1)[0])
    elif event in {"movewindow", "movewindowv2"}:
        handle_movewindow(payload.split(",", 1)[0])
    elif event in {"workspace", "workspacev2"}:
        sync_network_to_workspace()


def resolve_host(host: str, timeout: float = DNS_TIMEOUT_S) -> list[str]:
    def lookup() -> list[str]:
        infos = socket.getaddrinfo(host, None)
        addrs = {info[4][0] for info in infos if info[4]}
        return sorted(addrs)

    with ThreadPoolExecutor(max_workers=1) as pool:
        future = pool.submit(lookup)
        return future.result(timeout=timeout)


def resolve_hosts(hosts: list[str], last_good: dict[str, list[str]]) -> dict[str, list[str]]:
    merged: dict[str, list[str]] = {}
    for host in hosts:
        try:
            merged[host] = resolve_host(host)
        except Exception:
            if host in last_good:
                merged[host] = list(last_good[host])
    return merged


def sudo_nft(command: str, stdin_text: str = "") -> int:
    try:
        proc = subprocess.run(
            ["sudo", "-n", NFT_WRAPPER, command, "ds"],
            input=stdin_text,
            text=True,
            capture_output=True,
            check=False,
        )
    except FileNotFoundError:
        note_network_unavailable()
        return 127
    if proc.returncode != 0:
        note_network_unavailable()
    return proc.returncode


def note_network_unavailable() -> None:
    global _network_skip_notified
    if _network_skip_notified:
        return
    _network_skip_notified = True
    notify(
        "Distraction sites",
        "Network block is unavailable (missing install). Window placement still runs.",
    )


def wrapper_present() -> bool:
    if Path(NFT_WRAPPER).is_file():
        return True
    note_network_unavailable()
    return False


def replace_ds(addrs_by_host: dict[str, list[str]]) -> bool:
    if not wrapper_present():
        return False
    lines: list[str] = []
    for host in sorted(addrs_by_host):
        lines.extend(addrs_by_host[host])
    text = "\n".join(lines)
    if text:
        text += "\n"
    if sudo_nft("replace", text) != 0:
        return False
    save_addrs_last_good(addrs_by_host)
    return True


def flush_ds() -> bool:
    if not wrapper_present():
        return False
    return sudo_nft("flush") == 0


class NetworkWorker:
    def __init__(self) -> None:
        self.queue: queue.Queue[tuple[str, int] | None] = queue.Queue()
        self.generation = 0
        self.inflight = False
        self.started = False
        self.skipped_periodic = 0
        self._thread: threading.Thread | None = None

    def start(self) -> None:
        if self.started:
            return
        self.started = True
        self._thread = threading.Thread(target=self._loop, daemon=True)
        self._thread.start()

    def stop(self) -> None:
        if not self.started:
            return
        self.queue.put(None)
        if self._thread is not None:
            self._thread.join(timeout=2)
        self.started = False
        self._thread = None

    def bump(self) -> int:
        self.generation += 1
        return self.generation

    def request_resolve(self, reason: str) -> bool:
        if reason == "periodic" and (self.inflight or not self.queue.empty()):
            self.skipped_periodic += 1
            return False
        self.queue.put(("resolve", self.generation))
        return True

    def request_flush(self) -> None:
        self.queue.put(("flush", self.generation))

    def wait_idle(self, timeout: float = 4.0) -> None:
        deadline = time.time() + timeout
        while time.time() < deadline:
            if self.queue.empty() and not self.inflight:
                return
            time.sleep(0.01)
        raise TimeoutError("network worker did not go idle")

    def _loop(self) -> None:
        while True:
            job = self.queue.get()
            if job is None:
                return
            kind, gen = job
            self.inflight = True
            try:
                self._run(kind, gen)
            finally:
                self.inflight = False

    def _run(self, kind: str, gen: int) -> None:
        if kind == "resolve":
            with _state_lock:
                hosts = listed_hosts()
                last_good = load_addrs_last_good()
            addrs = resolve_hosts(hosts, last_good)
            if gen != self.generation:
                return
            if on_distractions():
                return
            if not hosts:
                flush_ds()
                return
            replace_ds(addrs)
            return
        if gen != self.generation:
            return
        if not on_distractions() and listed_hosts():
            return
        flush_ds()


def ensure_net_worker() -> NetworkWorker:
    _net.start()
    return _net


def sync_network_to_workspace() -> None:
    global _last_on_space
    ensure_net_worker()
    on_space = on_distractions()
    if on_space == _last_on_space:
        return
    _last_on_space = on_space
    _net.bump()
    if on_space or not listed_hosts():
        _net.request_flush()
        return
    _net.request_resolve("workspace")


def maybe_dns_tick() -> bool:
    if on_distractions():
        return False
    ensure_net_worker()
    return _net.request_resolve("periodic")


def apply_enforcement(expanded: list[dict], *, mutate_rules: bool) -> bool:
    global _active_expand
    if not mutate_rules:
        with _state_lock:
            _active_expand = expanded
        return True
    if not apply_named_rules(expanded):
        return False
    with _state_lock:
        _active_expand = expanded
    save_last_good_expand(expanded)
    return True


def bootstrap_enforcement() -> None:
    global _last_on_space
    _last_on_space = None
    ensure_net_worker()
    status, expanded = load_for_enforcement()
    apply_enforcement(expanded, mutate_rules=(status == "ok"))
    scan_existing_clients(notify_banner=False)
    sync_network_to_workspace()


def handle_reload_conn(conn: socket.socket) -> None:
    global _last_on_space
    try:
        conn.recv(1024)
        status, expanded = load_for_enforcement()
        if status == "corrupt":
            conn.sendall(b"error\n")
            return
        apply_enforcement(expanded, mutate_rules=True)
        _last_on_space = None
        sync_network_to_workspace()
        conn.sendall(b"ok\n")
    except OSError:
        try:
            conn.sendall(b"error\n")
        except OSError:
            pass
    finally:
        try:
            conn.close()
        except OSError:
            pass


def request_reload() -> bool:
    path = reload_sock_path()
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        sock.connect(str(path))
        sock.sendall(b"reload\n")
        reply = sock.recv(64)
        return reply.startswith(b"ok")
    except OSError:
        notify(
            "Distraction list",
            "The listener is not running. Enforcement was left unchanged.",
        )
        return False
    finally:
        sock.close()


def reset_runtime_state() -> None:
    global _active_expand, _banner_at, _last_on_space, _network_skip_notified, _net
    _active_expand = []
    _banner_at = {}
    _last_on_space = None
    _network_skip_notified = False
    if _net.started:
        _net.stop()
    _net = NetworkWorker()


_state_lock = threading.Lock()
_active_expand: list[dict] = []
_banner_at: dict[str, float] = {}
_last_on_space: bool | None = None
_network_skip_notified = False
_net = NetworkWorker()


def current() -> dict:
    return hyprctl_json("activeworkspace")


def current_id() -> int:
    return int(current()["id"])


def is_distraction(workspace: dict) -> bool:
    name = str(workspace.get("name") or "")
    return name == NAME or name == REF or int(workspace.get("id") or 0) == SAFE_ID


def on_distractions() -> bool:
    return is_distraction(current())


def occupied_ids() -> list[int]:
    workspaces = hyprctl_json("workspaces")
    return sorted({workspace["id"] for workspace in workspaces if workspace["id"] > 0})


def skip_ids() -> set[int]:
    return {workspace["id"] for workspace in hyprctl_json("workspaces") if is_distraction(workspace)}


def focus_workspace(workspace: str) -> None:
    dispatch(f'hl.dsp.focus({{ workspace = "{workspace}" }})')


def pin_id() -> None:
    # Named workspaces often get a Hyprland-managed id (e.g. -1337) which
    # already sits outside Super+1-0 and the 1-10 bar. Only retarget if a
    # numbered slot 1-10 got used.
    for workspace in hyprctl_json("workspaces"):
        if not is_distraction(workspace):
            continue
        ident = int(workspace["id"])
        if ident < 1 or ident > 10:
            return
        dispatch(
            f'hl.dsp.workspace.change_id({{ workspace = "{REF}", id = {SAFE_ID} }})'
        )
        return


def show() -> None:
    if not on_distractions():
        focus_workspace(REF)
    pin_id()


def hide() -> None:
    if not on_distractions():
        return
    focus_workspace("previous")
    if on_distractions():
        focus_workspace("1")


def is_focus() -> bool:
    if not FOCUS.exists():
        return True
    return FOCUS.read_text().strip().lower() != "off"


def set_focus(value: bool) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    FOCUS.write_text("on\n" if value else "off\n")


def ensure_focus_default() -> None:
    if not FOCUS.exists():
        set_focus(True)


def blocked_message() -> None:
    notify(
        "Focus mode is on",
        "The distraction space is locked. Super+Ctrl+Shift+F, then a 50-character reason, to leave.",
    )


def enter() -> None:
    if on_distractions():
        return
    if is_focus():
        blocked_message()
        return
    show()


def toggle() -> None:
    if on_distractions():
        hide()
        return
    enter()


def cycle(step: int) -> None:
    ids = occupied_ids()
    current = current_id()
    if current not in ids:
        ids.append(current)
        ids.sort()
    if not ids:
        return
    index = ids.index(current)
    for _ in range(len(ids)):
        index = (index + step) % len(ids)
        candidate = ids[index]
        if candidate not in skip_ids():
            focus_workspace(str(candidate))
            return


def enable_focus() -> None:
    set_focus(True)
    if on_distractions():
        hide()
    notify("Focus mode on", "The distraction space is locked. Super+D will not open it.")


def disable_focus(reason: str) -> None:
    reason = " ".join(reason.split())
    if len(reason) < MIN_REASON:
        raise SystemExit(
            f"reason must be at least {MIN_REASON} characters (got {len(reason)})"
        )
    stamp = datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds")
    with log_path().open("a", encoding="utf-8") as handle:
        handle.write(f"{stamp}  {reason}\n")
    set_focus(False)
    notify("Focus mode off", "Super+D opens the distraction space.")


def prompt_reason() -> str | None:
    try:
        result = subprocess.run(
            [
                "zenity",
                "--entry",
                "--title=Leave focus mode",
                "--text=Write at least 50 characters on why you are leaving focus mode.",
                "--width=520",
                "--ok-label=Turn off",
                "--cancel-label=Stay focused",
            ],
            capture_output=True,
            text=True,
            check=False,
        )
    except FileNotFoundError:
        notify("Focus mode", "zenity is missing; cannot ask for a reason.")
        return None
    if result.returncode != 0:
        return None
    return result.stdout.strip()


def request_focus_toggle() -> None:
    if not is_focus():
        enable_focus()
        return
    reason = prompt_reason()
    if reason is None:
        return
    try:
        disable_focus(reason)
    except SystemExit as exc:
        notify("Focus mode", str(exc))


def listen() -> None:
    ensure_focus_default()
    pin_id()
    runtime = Path(os.environ["XDG_RUNTIME_DIR"])
    signature = os.environ["HYPRLAND_INSTANCE_SIGNATURE"]
    sock_path = runtime / "hypr" / signature / ".socket2.sock"

    lock = open(LISTEN_LOCK, "w")
    try:
        import fcntl

        fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return

    if is_focus() and on_distractions():
        hide()

    bootstrap_enforcement()

    reload_path = reload_sock_path()
    try:
        reload_path.unlink()
    except FileNotFoundError:
        pass
    reload_sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    reload_sock.bind(str(reload_path))
    reload_sock.listen(4)

    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.connect(str(sock_path))
    last_tick = now()
    buf = ""
    try:
        while True:
            remaining = DNS_INTERVAL_S - (now() - last_tick)
            timeout = 1.0 if remaining > 1.0 else max(0.05, remaining)
            readable, _, _ = select.select([sock, reload_sock], [], [], timeout)
            if is_focus() and on_distractions():
                hide()
            if now() - last_tick >= DNS_INTERVAL_S:
                last_tick = now()
                maybe_dns_tick()
            for ready in readable:
                if ready is reload_sock:
                    conn, _unused = reload_sock.accept()
                    handle_reload_conn(conn)
                    continue
                chunk = sock.recv(4096)
                if not chunk:
                    return
                buf += chunk.decode("utf-8", errors="replace")
                while "\n" in buf:
                    line, buf = buf.split("\n", 1)
                    process_socket2_line(line)
    finally:
        reload_sock.close()
        try:
            reload_path.unlink()
        except FileNotFoundError:
            pass


def main() -> None:
    command = sys.argv[1] if len(sys.argv) > 1 else "toggle"
    if command == "toggle":
        toggle()
    elif command == "enter":
        enter()
    elif command == "next":
        cycle(1)
    elif command == "prev":
        cycle(-1)
    elif command == "listen":
        listen()
    elif command in {"focus", "focus-toggle"}:
        request_focus_toggle()
    elif command == "focus-on":
        if not is_focus():
            enable_focus()
    elif command == "focus-off":
        reason = " ".join(sys.argv[2:]).strip()
        if not reason and not sys.stdin.isatty():
            reason = sys.stdin.read().strip()
        disable_focus(reason)
    elif command == "focus-status":
        raise SystemExit(0 if is_focus() else 1)
    elif command == "log-path":
        print(log_path())
    elif command == "print-expand":
        print_expand()
    elif command == "reload":
        raise SystemExit(0 if request_reload() else 1)
    else:
        raise SystemExit(f"unknown command: {command}")


if __name__ == "__main__":
    main()

        raise ValueError(f"member window classes {got} != expand map {expected}")


def leading_origin_host(body: str) -> str:
    text = str(body or "")
    match = ORIGIN_LINK.match(text) or ORIGIN_BARE.match(text)
    if not match:
        return ""
    token = match.group(1)
    host = re.sub(r"^https?://", "", token, flags=re.I)
    host = re.sub(r"^www\.", "", host, flags=re.I)
    return host.split("/")[0].split(":")[0].lower()


def is_chromium_derived(app: str, app_icon: str = "") -> bool:
    source = f"{app}\n{app_icon}".lower()
    return any(hint in source for hint in CHROMIUM_HINTS)


def is_generic_browser_identity(value: object) -> bool:
    return normalize_token(value) in GENERIC_BROWSER


def _list_has(values: object, candidate: object) -> bool:
    needle = normalize_token(candidate)
    if not needle or not isinstance(values, list):
        return False
    return any(normalize_token(item) == needle for item in values)


def match_banner(app: str, app_icon: str, body: str, members: list[dict] | None = None) -> str | None:
    if normalize_token(app) in FORBIDDEN_TOAST_APPS:
        return None
    members = members if members is not None else load_members()
    if is_chromium_derived(app, app_icon):
        host = leading_origin_host(body)
        if not host:
            return None
        for member in members:
            hosts = ((member.get("chromium") or {}).get("hosts") or [])
            if any(normalize_token(item) == host for item in hosts):
                return str(member["label"])
        return None
    for member in members:
        native = member.get("native") or {}
        if _list_has(native.get("app"), app) or _list_has(native.get("appIcon"), app_icon):
            return str(member["label"])
    return None


PWA_IDENTITY_FLAGS = ("--app-id", "--app", "--class", "--desktop-file-name")
PWA_HOST = re.compile(r"^[a-z0-9-]+(?:\.[a-z0-9-]+)+$", re.I)
PWA_URL_HOST = re.compile(r"^(?:https?://|www\.)([a-z0-9-]+(?:\.[a-z0-9-]+)+)", re.I)
PWA_DESKTOP_ENTRY = re.compile(r"^chrome-([a-z0-9-]+(?:\.[a-z0-9-]+)+)__", re.I)


def _argv_tokens(line: str) -> list[str]:
    return [token for token in str(line or "").split() if token]


def _flag_name(token: str) -> str:
    return token.split("=", 1)[0].lower()


def _pwa_identity_value(value: str) -> str:
    text = str(value or "").strip().strip("\"'")
    if not text:
        return ""
    desktop = PWA_DESKTOP_ENTRY.match(text)
    if desktop:
        return desktop.group(1).lower()
    url = PWA_URL_HOST.match(text)
    if url:
        return url.group(1).lower().rstrip(".")
    bare = text.split("/")[0].split(":")[0]
    if PWA_HOST.fullmatch(bare):
        return bare.lower()
    return ""


def cmdline_identity_tokens(cmdlines: list[str]) -> set[str]:
    tokens: set[str] = set()
    for line in cmdlines:
        argv = _argv_tokens(line)
        index = 0
        while index < len(argv):
            raw = argv[index]
            name = _flag_name(raw)
            value = ""
            if name in PWA_IDENTITY_FLAGS:
                if "=" in raw:
                    value = raw.split("=", 1)[1]
                elif index + 1 < len(argv):
                    index += 1
                    value = argv[index]
            elif PWA_DESKTOP_ENTRY.match(raw):
                value = raw
            ident = _pwa_identity_value(value)
            if ident:
                tokens.add(ident)
            index += 1
    return tokens


def match_stream(
    properties: dict,
    cmdline_chain: list[str],
    members: list[dict] | None = None,
) -> str | None:
    members = members if members is not None else load_members()
    name = properties.get("application.name") or ""
    binary = properties.get("application.process.binary") or ""
    chromium = is_chromium_derived(name, binary) or any(
        is_chromium_derived(line, "") for line in cmdline_chain
    )
    if not chromium:
        for member in members:
            native = member.get("native") or {}
            if _list_has(native.get("pulseName"), name) or _list_has(native.get("pulseBinary"), binary):
                return str(member["label"])
        return None
    found = cmdline_identity_tokens(cmdline_chain)
    for member in members:
        wanted = list((member.get("chromium") or {}).get("hosts") or [])
        wanted += list((member.get("chromium") or {}).get("appIds") or [])
        if any(normalize_token(token) in found for token in wanted if token):
            return str(member["label"])
    return None



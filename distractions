def menu_select(prompt: str, options: list[str], *, quiet: bool = False) -> str | None:
    try:
        result = subprocess.run(
            [MENU_SELECT_BIN, prompt, *options],
            capture_output=True,
            text=True,
            check=False,
        )
    except OSError:
        if not quiet:
            notify("Focus mode", "Agent picker could not open; previous setting kept.")
        return None
    if result.returncode != 0:
        if not quiet:
            notify("Focus mode", "Agent picker closed; previous setting kept.")
        return None
    return (result.stdout or "").strip()


def cmd_agent_summaries() -> None:
    selected = menu_select("Agent summaries", list(AGENT_SUMMARIES_OPTIONS))
    if selected is None:
        return
    if selected == "On":
        updated = update_focus_config(agent_summaries=True)
        if updated and not resolve_summary_agent():
            notify(
                "Focus mode",
                "No usable summary agent. Grouped-count catch-up stays in place.",
            )
        if updated and is_focus():
            arm_summary_after_mute(resume=True)
        return
    if selected == "Off":
        if update_focus_config(agent_summaries=False) and is_focus():
            request_summary_finish()
        return
    notify("Focus mode", "Rejected agent-summaries setting; previous setting kept.")


def cmd_summary_agent() -> None:
    selected = menu_select("Summary agent", list(SUMMARY_AGENT_PICKER_OPTIONS))
    if selected is None:
        return
    if selected == "Omarchy default":
        update_focus_config(summary_agent=None)
        return
    token = selected.split("\t")[-1].strip().lower()
    if token not in ALLOWED_SUMMARY_AGENTS:
        notify("Focus mode", "Rejected summary agent; previous setting kept.")
        return
    update_focus_config(summary_agent=token)



def format_list_text(rows: list) -> str:
    lines = [LIST_EDITOR_HEADER.rstrip()]
    for entry in rows:
        if not isinstance(entry, dict):
            continue
        name = _entry_name(entry)
        if name is None:
            continue
        raw_class = entry.get("class")
        klass = raw_class.strip() if isinstance(raw_class, str) else ""
        hosts: list[str] = []
        raw_hosts = entry.get("hosts")
        if isinstance(raw_hosts, list):
            hosts = [host.strip() for host in raw_hosts if isinstance(host, str) and host.strip()]
        if klass or hosts:
            line = f"{name} | {klass}"
            if hosts:
                line += f" | {' '.join(hosts)}"
            lines.append(line)
        else:
            lines.append(name)
    return "\n".join(lines) + "\n"


def parse_list_text(text: str) -> list[dict]:
    rows: list[dict] = []
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        parts = [part.strip() for part in line.split("|")]
        name = parts[0] if parts else ""
        klass = parts[1] if len(parts) > 1 else ""
        hosts_field = parts[2] if len(parts) > 2 else ""
        entry: dict = {"name": name}
        if klass:
            entry["class"] = klass
        hosts = [host for host in hosts_field.split() if host]
        if hosts:
            entry["hosts"] = hosts
        rows.append(entry)
    return rows


def accept_editor_rows(rows: list) -> list[dict]:
    pending: list[dict] = []
    seen: set[str] = set()
    for entry in rows:
        if not isinstance(entry, dict):
            continue
        name = _entry_name(entry)
        if name is None or name in seen:
            continue
        seen.add(name)
        mapped = EXPAND_MAP.get(name)
        raw_class = entry.get("class")
        klass = raw_class.strip() if isinstance(raw_class, str) and raw_class.strip() else None
        hosts: list[str] = []
        raw_hosts = entry.get("hosts")
        if isinstance(raw_hosts, list):
            hosts = [host.strip() for host in raw_hosts if isinstance(host, str) and host.strip()]
        if mapped is None and not klass and not hosts:
            continue
        out: dict = {"name": name}
        if klass:
            out["class"] = klass
        if hosts:
            out["hosts"] = hosts
        pending.append(out)
    slugs: dict[str, list[str]] = {}
    for row in pending:
        slugs.setdefault(sanitize_product(row["name"]), []).append(row["name"])
    colliding = {
        name
        for names in slugs.values()
        if len(names) > 1
        for name in names
    }
    return [row for row in pending if row["name"] not in colliding]



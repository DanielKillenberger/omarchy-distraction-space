def members_match_windows(members: list[dict] | None = None, windows_path: Path | None = None) -> None:
    del windows_path
    members = members if members is not None else load_members()
    got: list[str] = []
    expected: list[str] = []
    for member in members:
        label = str(member.get("label") or "")
        expand_name = MUTE_LABEL_TO_EXPAND.get(label)
        if expand_name is None:
            raise ValueError(f"mute member {label!r} is not a classed expand-map app")
        mapped = EXPAND_MAP.get(expand_name) or {}
        klass = mapped.get("class")
        if not klass:
            raise ValueError(f"expand map {expand_name!r} has no class")
        got.append(_hypr_class_norm(str(member.get("window_class") or "")))
        expected.append(_hypr_class_norm(str(klass)))

def hyprctl(*args: str) -> str:
    return subprocess.check_output(["hyprctl", *args], text=True)


def hyprctl_json(*args: str):
    return json.loads(hyprctl("-j", *args))


def dispatch(lua: str) -> None:
    subprocess.check_call(["hyprctl", "dispatch", lua])


def notify(title: str, body: str = "", timeout_ms: int = 4000) -> bool:
    cmd = ["omarchy-notification-send", "-u", "normal", "-t", str(timeout_ms), title]
    if body:
        cmd.append(body)
    try:
        subprocess.check_call(cmd, timeout=NOTIFY_WAIT_S)
        return True
    except subprocess.TimeoutExpired:
        return False
    except (subprocess.CalledProcessError, FileNotFoundError):
        try:
            return subprocess.call(
                ["notify-send", "-t", str(timeout_ms), title, body],
                timeout=NOTIFY_WAIT_S,
            ) == 0
        except (FileNotFoundError, subprocess.TimeoutExpired):
            return False


class SummaryAgentError(RuntimeError):
    pass


def load_config() -> dict:
    data: dict = {}
    if CONFIG_PATH.exists():
        try:
            loaded = json.loads(CONFIG_PATH.read_text())
        except json.JSONDecodeError:
            loaded = {}
        if isinstance(loaded, dict):
            data = loaded
    if "agent_summaries" not in data:
        data["agent_summaries"] = False
    if "summary_agent" not in data:
        data["summary_agent"] = None
    return data


def _lock_focus_config():
    FOCUS_CONFIG_LOCK.parent.mkdir(parents=True, exist_ok=True)
    handle = open(FOCUS_CONFIG_LOCK, "w")
    fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
    return handle


def write_focus_config(data: dict) -> None:
    if not isinstance(data, dict):
        raise ValueError("rejected focus config")
    agent = data.get("summary_agent")
    if agent not in (None, "claude", "grok"):
        raise ValueError(f"rejected summary_agent {agent!r}")
    summaries = data.get("agent_summaries", False)
    if summaries not in (True, False):
        raise ValueError("rejected agent_summaries")
    payload = dict(data)
    payload["agent_summaries"] = summaries
    payload["summary_agent"] = agent
    path = CONFIG_PATH
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp_name = tempfile.mkstemp(prefix=path.name + ".", suffix=".tmp", dir=str(path.parent))
    tmp = Path(tmp_name)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(json.dumps(payload, indent=2) + "\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(tmp, path)
    except Exception:
        tmp.unlink(missing_ok=True)
        raise


def update_focus_config(**changes) -> bool:
    lock = None
    try:
        lock = _lock_focus_config()
        merged = dict(load_config())
        merged.update(changes)
        write_focus_config(merged)
        return True
    except (ValueError, OSError, TypeError):
        return False
    finally:
        if lock is not None:
            lock.close()


def agent_summaries_enabled(config: dict | None = None) -> bool:
    cfg = load_config() if config is None else config
    return cfg.get("agent_summaries") is True


def omarchy_default_agent() -> str:
    try:
        result = subprocess.run(
            ["omarchy", "default", "agent"],
            capture_output=True,
            text=True,
            timeout=5,
            check=False,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return ""
    return (result.stdout or "").strip()


def resolve_summary_agent(config: dict | None = None) -> str:
    cfg = load_config() if config is None else config
    override = cfg.get("summary_agent")
    if override in ALLOWED_SUMMARY_AGENTS:
        return str(override)
    if override is not None:
        return ""
    default = omarchy_default_agent()
    return default if default in ALLOWED_SUMMARY_AGENTS else ""


def summary_agent_picker_ids() -> tuple[str | None, ...]:
    ids: list[str | None] = []
    for option in SUMMARY_AGENT_PICKER_OPTIONS:
        if option == "Omarchy default":
            ids.append(None)
            continue
        ids.append(option.split("\t")[-1])
    return tuple(ids)


def menu_select(prompt: str, options: list[str]) -> str | None:
    try:
        result = subprocess.run(
            [MENU_SELECT_BIN, prompt, *options],
            capture_output=True,
            text=True,
            check=False,
        )
    except OSError:
        notify("Focus mode", "Agent picker could not open; previous setting kept.")
        return None
    if result.returncode != 0:
        notify("Focus mode", "Agent picker closed; previous setting kept.")
        return None
    return (result.stdout or "").strip()


def cmd_agent_summaries() -> None:
    selected = menu_select("Agent summaries", list(AGENT_SUMMARIES_OPTIONS))
    if selected is None:
        return
    if selected == "On":
        if update_focus_config(agent_summaries=True) and not resolve_summary_agent():
            notify(
                "Focus mode",
                "No usable summary agent. Grouped-count catch-up stays in place.",
            )
        return
    if selected == "Off":
        update_focus_config(agent_summaries=False)
        return
    notify("Focus mode", "Rejected agent-summaries setting; previous setting kept.")


def cmd_summary_agent() -> None:
    selected = menu_select("Summary agent", list(SUMMARY_AGENT_PICKER_OPTIONS))
    if selected is None:
        return
    if selected == "Omarchy default":
        update_focus_config(summary_agent=None)
        return
    token = selected.split("\t")[-1].strip().lower()
    if token not in ALLOWED_SUMMARY_AGENTS:
        notify("Focus mode", "Rejected summary agent; previous setting kept.")
        return
    update_focus_config(summary_agent=token)



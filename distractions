#!/usr/bin/env python3
"""CLI entry for the distraction space plugin."""

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from ds import catalog, config, hold, hypr, launch, listener, lock, setup, state, ui

COMMANDS = {
    "status": state.cmd_status,
    "list": config.cmd_list,
    "config": config.cmd_config,
    "catalog": catalog.cmd_catalog,
    "lock": lock.cmd_lock,
    "unlock": lock.cmd_unlock,
    "enter": lock.cmd_enter,
    "leave": lock.cmd_leave,
    "toggle": lock.cmd_toggle,
    "next": hypr.cmd_next,
    "prev": hypr.cmd_prev,
    "menu": ui.cmd_menu,
    "listen": listener.cmd_listen,
    "reload": listener.cmd_reload,
    "refresh": listener.cmd_refresh,
    "release": listener.cmd_release,
    "setup": setup.cmd_setup,
    "senders": hold.cmd_senders,
    "banners": state.cmd_banners,
    "open": launch.cmd_open,
}


def positive_int(value):
    try:
        n = int(value)
    except ValueError:
        n = 0
    if n < 1:
        raise argparse.ArgumentTypeError(f"{value!r} is not a positive integer")
    return n


def release_minutes(value):
    n = positive_int(value)
    if n > config.RELEASE_MAX_MINUTES:
        raise argparse.ArgumentTypeError(f"{value!r} is over the {config.RELEASE_MAX_MINUTES} minute limit")
    return n


def build_parser():
    p = argparse.ArgumentParser(prog="distractions")
    sub = p.add_subparsers(dest="command")
    sub.add_parser("status").add_argument("--json", action="store_true")
    ls = sub.add_parser("list").add_subparsers(dest="list_cmd")
    ls.add_parser("add").add_argument("entry")
    ls.add_parser("remove").add_argument("name")
    ls.add_parser("expand")
    cs = sub.add_parser("config").add_subparsers(dest="config_cmd")
    cs.add_parser("path")
    cs.add_parser("get").add_argument("key")
    s = cs.add_parser("set")
    s.add_argument("key")
    s.add_argument("value")
    cs.add_parser("edit")
    sub.add_parser("catalog")
    lk = sub.add_parser("lock")
    lk.add_argument("duration", nargs="?")
    lk.add_argument("purpose", nargs="*")
    sub.add_parser("unlock").add_argument("reason", nargs="*")
    for name in ("enter", "leave", "toggle", "next", "prev", "menu", "listen", "reload", "refresh"):
        sub.add_parser(name)
    sub.add_parser("release").add_argument("minutes", nargs="?", type=release_minutes)
    sub.add_parser("setup").add_argument("--remove", action="store_true")
    sub.add_parser("senders")
    banners = sub.add_parser("banners")
    banners.add_argument("--count", type=positive_int, default=20, metavar="N")
    sub.add_parser("open").add_argument("target")
    return p


def main(argv=None):
    args = build_parser().parse_args(argv)
    if not args.command:
        sys.exit(2)
    try:
        rc = COMMANDS[args.command](args)
    except NotImplementedError:
        print("not yet", file=sys.stderr)
        sys.exit(2)
    sys.exit(rc if rc is not None else 0)


if __name__ == "__main__":
    main()

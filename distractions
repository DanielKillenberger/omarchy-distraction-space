def is_distraction(workspace: dict) -> bool:
    name = str(workspace.get("name") or "")
    return name == NAME or name == REF or int(workspace.get("id") or 0) == SAFE_ID


def on_distractions() -> bool:
    return is_distraction(current())


def occupied_ids() -> list[int]:
    workspaces = hyprctl_json("workspaces")
    return sorted({workspace["id"] for workspace in workspaces if workspace["id"] > 0})


def skip_ids() -> set[int]:
    return {workspace["id"] for workspace in hyprctl_json("workspaces") if is_distraction(workspace)}


def focus_workspace(workspace: str) -> None:
    dispatch(f'hl.dsp.focus({{ workspace = "{workspace}" }})')


def pin_id() -> None:
    # Named workspaces often get a Hyprland-managed id (e.g. -1337) which
    # already sits outside Super+1-0 and the 1-10 bar. Only retarget if a
    # numbered slot 1-10 got used.
    for workspace in hyprctl_json("workspaces"):
        if not is_distraction(workspace):
            continue
        ident = int(workspace["id"])
        if ident < 1 or ident > 10:
            return
        dispatch(
            f'hl.dsp.workspace.change_id({{ workspace = "{REF}", id = {SAFE_ID} }})'
        )
        return


def show() -> None:
    if not on_distractions():
        focus_workspace(REF)
    pin_id()


def hide() -> None:
    if not on_distractions():
        return
    focus_workspace("previous")
    if on_distractions():
        focus_workspace("1")


def is_focus() -> bool:
    if not FOCUS.exists():
        return True
    return FOCUS.read_text().strip().lower() != "off"


def set_focus(value: bool) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    FOCUS.write_text("on\n" if value else "off\n")


def ensure_focus_default() -> None:
    if not FOCUS.exists():
        set_focus(True)


def blocked_message() -> None:
    notify(
        "Focus mode is on",
        "The distraction space is locked. Super+Ctrl+Shift+F, then a 50-character reason, to leave.",
    )


def enter() -> None:
    if on_distractions():
        return
    if is_focus():
        blocked_message()
        return
    show()


def toggle() -> None:
    if on_distractions():
        hide()
        return
    enter()


def cycle(step: int) -> None:
    ids = occupied_ids()
    current = current_id()
    if current not in ids:
        ids.append(current)
        ids.sort()
    if not ids:
        return
    index = ids.index(current)
    for _ in range(len(ids)):
        index = (index + step) % len(ids)
        candidate = ids[index]
        if candidate not in skip_ids():
            focus_workspace(str(candidate))
            return



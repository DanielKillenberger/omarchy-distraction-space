    save_addrs_last_good(addrs_by_host)
    return True


def flush_ds() -> bool:
    if not wrapper_present():
        return False
    return sudo_nft("flush") == 0


class NetworkWorker:
    def __init__(self) -> None:
        self.queue: queue.Queue[tuple[str, int] | None] = queue.Queue()
        self.generation = 0
        self.inflight = False
        self.started = False
        self.skipped_periodic = 0
        self._thread: threading.Thread | None = None
        self._submit_lock = threading.Lock()
        self._done = threading.Condition()
        self._inflight_gen: int | None = None
        self._results: dict[int, bool] = {}
        self._pending = 0

    def start(self) -> None:
        if self.started:
            return
        self.started = True
        self._thread = threading.Thread(target=self._loop, daemon=True)
        self._thread.start()

    def stop(self) -> None:
        if not self.started:
            return
        self.queue.put(None)
        if self._thread is not None:
            self._thread.join(timeout=2)
        self.started = False
        self._thread = None

    def bump(self) -> int:
        with self._submit_lock:
            self.generation += 1
            return self.generation

    def _submit_if_current(self, gen: int, action) -> bool:
        with self._submit_lock:
            if gen != self.generation:
                return False
            action()
            return True

    def request_resolve(self, reason: str) -> bool:
        if reason == "periodic" and (self.inflight or not self.queue.empty()):
            self.skipped_periodic += 1
            return False
        with self._done:
            self.queue.put(("resolve", self.generation))
            self._pending += 1
            self._done.notify_all()
        return True

    def request_flush(self) -> None:
        with self._done:
            self.queue.put(("flush", self.generation))
            self._pending += 1
            self._done.notify_all()

    def wait_idle(self, timeout: float = 4.0) -> None:
        deadline = time.time() + timeout
        while time.time() < deadline:
            if self.queue.empty() and not self.inflight:
                return
            time.sleep(0.01)
        raise TimeoutError("network worker did not go idle")

    def wait_current_apply(self, gen: int, timeout: float = 60.0) -> bool:
        deadline = time.time() + timeout
        with self._done:
            while True:
                if gen in self._results:
                    return self._results[gen]
                if self._inflight_gen is None and self._pending == 0:
                    return False
                remaining = deadline - time.time()
                if remaining <= 0:
                    return False
                self._done.wait(timeout=min(0.05, remaining))

    def _finish(self, gen: int, ok: bool) -> None:
        with self._done:
            self._results[gen] = ok
            self._pending = max(0, self._pending - 1)
            self.inflight = False
            self._inflight_gen = None
            self._done.notify_all()

    def _loop(self) -> None:
        while True:
            job = self.queue.get()
            if job is None:
                return
            kind, gen = job
            with self._done:
                self.inflight = True
                self._inflight_gen = gen
            ok = False
            try:
                ok = self._run(kind, gen)
            finally:
                self._finish(gen, ok)

    def _run(self, kind: str, gen: int) -> bool:
        applied = True

        def network_ok(ok: bool) -> bool:
            if ok or not Path(NFT_WRAPPER).is_file():
                return True
            return False

        if kind == "resolve":
            with _state_lock:
                hosts = listed_hosts()
                last_good = load_addrs_last_good()
            addrs = resolve_hosts(hosts, last_good)
            def submit_resolve() -> None:
                nonlocal applied
                if on_distractions():
                    return
                if not hosts:
                    applied = network_ok(flush_ds())
                    return
                applied = network_ok(replace_ds(addrs))

            if not self._submit_if_current(gen, submit_resolve):
                return True
            return applied
        def submit_flush() -> None:
            nonlocal applied
            if not on_distractions() and listed_hosts():
                return
            applied = network_ok(flush_ds())

        if not self._submit_if_current(gen, submit_flush):
            return True
        return applied


def ensure_net_worker() -> NetworkWorker:

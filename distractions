def parse_claude_version(text: str) -> tuple[int, int, int] | None:
    match = re.search(r"(\d+)\.(\d+)\.(\d+)", text)
    if not match:
        return None
    return int(match.group(1)), int(match.group(2)), int(match.group(3))


def claude_version_ok(text: str) -> bool:
    parsed = parse_claude_version(text)
    return parsed is not None and parsed >= CLAUDE_MIN_VERSION


def _empty_workdir(prefix: str) -> Path:
    path = Path(tempfile.mkdtemp(prefix=prefix))
    os.chmod(path, 0o700)
    return path


def _cleanup_dir(path: Path | None) -> None:
    if path is None:
        return
    shutil.rmtree(path, ignore_errors=True)


def _agent_base_env() -> dict[str, str]:
    keep: dict[str, str] = {}
    for key in (
        "PATH",
        "LANG",
        "LC_ALL",
        "LC_CTYPE",
        "TERM",
        "USER",
        "LOGNAME",
        "TMPDIR",
        "XDG_RUNTIME_DIR",
    ):
        value = os.environ.get(key)
        if value:
            keep[key] = value
    return keep


def _kill_process_group(proc: subprocess.Popen) -> None:
    if proc.pid is None:
        return
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except (ProcessLookupError, PermissionError, OSError):
        pass
    try:
        proc.kill()
    except (ProcessLookupError, PermissionError, OSError):
        pass


def _apply_parse_rlimits() -> None:
    try:
        resource.setrlimit(resource.RLIMIT_AS, (PARSE_RLIMIT_AS, PARSE_RLIMIT_AS))
        resource.setrlimit(resource.RLIMIT_FSIZE, (PARSE_RLIMIT_FSIZE, PARSE_RLIMIT_FSIZE))
        resource.setrlimit(resource.RLIMIT_NPROC, (PARSE_RLIMIT_NPROC, PARSE_RLIMIT_NPROC))
    except (ValueError, OSError) as exc:
        raise OSError(f"could not apply parse rlimits: {exc}") from exc


def _as_bytes(value) -> bytes:
    if value is None:
        return b""
    if isinstance(value, bytes):
        return value
    return str(value).encode()


def _truncate_bytes(text: str, max_bytes: int) -> str:
    raw = (text or "").encode()
    if len(raw) <= max_bytes:
        return text or ""
    return raw[:max_bytes].decode("utf-8", "ignore")


def _pump_bounded(src, limit: int) -> tuple[bytes, bool]:
    buf = bytearray()
    overflow = False
    if src is None or not hasattr(src, "read"):
        return b"", False
    while True:
        chunk = src.read(4096)
        if not chunk:
            break
        data = _as_bytes(chunk)
        room = limit - len(buf)
        if room <= 0:
            overflow = True
            break
        if len(data) > room:
            buf.extend(data[:room])
            overflow = True
            break
        buf.extend(data)
    return bytes(buf), overflow


def _run_agent(
    argv: list[str],
    *,
    cwd: Path,
    env: dict[str, str],
    prompt: str | None = None,
) -> subprocess.CompletedProcess:
    stdin = subprocess.PIPE if prompt is not None else subprocess.DEVNULL
    proc = subprocess.Popen(
        argv,
        cwd=str(cwd),
        env=env,
        stdin=stdin,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=False,
        start_new_session=True,
        preexec_fn=_apply_parse_rlimits,
    )
    expected_session = str(getattr(_agent_invocation, "session_id", "") or "")
    pid_published = False
    if expected_session:
        pid_published = _record_agent_pid(proc.pid, expected_session)
        if not pid_published:
            _kill_process_group(proc)
            try:
                proc.wait(timeout=1)
            except (subprocess.TimeoutExpired, ProcessLookupError, OSError):
                _kill_process_group(proc)
            _record_agent_pid(None, expected_session, expected_pid=proc.pid)
            raise SummaryAgentError("could not bind agent child to summary session")
    overflow = False
    try:
        stdout_pipe = getattr(proc, "stdout", None)
        fileno = getattr(stdout_pipe, "fileno", None)
        use_stream = False
        if callable(fileno):
            try:
                use_stream = isinstance(fileno(), int)
            except (OSError, TypeError, ValueError):
                use_stream = False
        if not use_stream:
            stdout, stderr = proc.communicate(
                input=None if prompt is None else _as_bytes(prompt),
                timeout=AGENT_CHILD_TIMEOUT_S,
            )
            out_bytes = _as_bytes(stdout)
            err_bytes = _as_bytes(stderr)
            overflow = len(out_bytes) > PARSE_STDOUT_MAX or len(err_bytes) > PARSE_STDOUT_MAX
        else:
            deadline = time.monotonic() + AGENT_CHILD_TIMEOUT_S
            if prompt is not None and proc.stdin is not None:
                proc.stdin.write(prompt.encode())
                proc.stdin.close()
            out_holder: list[tuple[bytes, bool]] = []
            err_holder: list[tuple[bytes, bool]] = []

            def read_out() -> None:
                out_holder.append(_pump_bounded(proc.stdout, PARSE_STDOUT_MAX))

            def read_err() -> None:
                err_holder.append(_pump_bounded(proc.stderr, PARSE_STDOUT_MAX))

            readers = [
                threading.Thread(target=read_out, daemon=True),
                threading.Thread(target=read_err, daemon=True),
            ]
            for thread in readers:
                thread.start()
            remaining = deadline - time.monotonic()
            for thread in readers:
                thread.join(timeout=max(0.01, remaining))
                remaining = deadline - time.monotonic()
            if any(thread.is_alive() for thread in readers):
                _kill_process_group(proc)
                raise subprocess.TimeoutExpired(argv, AGENT_CHILD_TIMEOUT_S)
            proc.wait(timeout=max(0.01, deadline - time.monotonic()))
            out_bytes, out_over = out_holder[0] if out_holder else (b"", False)
            err_bytes, err_over = err_holder[0] if err_holder else (b"", False)
            overflow = out_over or err_over
    except subprocess.TimeoutExpired:
        _kill_process_group(proc)
        try:
            proc.communicate(timeout=1)
        except subprocess.TimeoutExpired:
            _kill_process_group(proc)
            proc.communicate()
        raise
    finally:
        if pid_published:
            _record_agent_pid(None, expected_session, expected_pid=proc.pid)
    if overflow:
        _kill_process_group(proc)
        raise SummaryAgentError("agent stdout exceeds bound")
    return subprocess.CompletedProcess(
        argv,
        proc.returncode,
        out_bytes.decode("utf-8", "replace"),
        err_bytes.decode("utf-8", "replace"),
    )


def prepare_grok_home() -> Path:
    home = None
    try:
        home = _empty_workdir("focus-grok-home-")
        if GROK_AUTH_SOURCE.is_file():
            dest = home / "auth.json"
            dest.write_bytes(GROK_AUTH_SOURCE.read_bytes())
            os.chmod(dest, 0o600)
        dest_cfg = home / "config.toml"
        dest_cfg.write_text(GROK_CONFIG_TOML, encoding="utf-8")
        os.chmod(dest_cfg, 0o600)
        return home
    except Exception:
        _cleanup_dir(home)
        raise


def prepare_claude_home(config_dir: Path) -> None:
    if not CLAUDE_CREDENTIAL_SOURCE.is_file():
        return
    dest_dir = config_dir / ".claude"
    dest_dir.mkdir(mode=0o700, exist_ok=True)
    dest = dest_dir / ".credentials.json"
    dest.write_bytes(CLAUDE_CREDENTIAL_SOURCE.read_bytes())
    os.chmod(dest, 0o600)


def _apply_closed_bundle(env: dict[str, str], keys: tuple[str, ...], *, require_all: bool = False) -> None:
    values = {key: os.environ.get(key) for key in keys}
    present = {key: value for key, value in values.items() if value}
    if not present:
        return
    if require_all and len(present) != len(keys):
        return
    env.update(present)


def claude_invoke_env(cwd: Path, config_dir: Path) -> dict[str, str]:
    env = _agent_base_env()
    env["HOME"] = str(cwd)
    env["CLAUDE_CONFIG_DIR"] = str(config_dir / ".claude")
    token = os.environ.get("ANTHROPIC_AUTH_TOKEN")
    api_key = os.environ.get("ANTHROPIC_API_KEY")
    base = os.environ.get("ANTHROPIC_BASE_URL")
    oauth = os.environ.get("CLAUDE_CODE_OAUTH_TOKEN")
    if token and base:
        env["ANTHROPIC_AUTH_TOKEN"] = token
        env["ANTHROPIC_BASE_URL"] = base
        return env
    if api_key:
        env["ANTHROPIC_API_KEY"] = api_key
        if base:
            env["ANTHROPIC_BASE_URL"] = base
        return env
    if oauth:
        env["CLAUDE_CODE_OAUTH_TOKEN"] = oauth
        if base:
            env["ANTHROPIC_BASE_URL"] = base
    return env


def inspect_grok_config(home: Path) -> dict:
    path = home / "config.toml"
    try:
        with path.open("rb") as handle:
            data = tomllib.load(handle)
    except (OSError, tomllib.TOMLDecodeError):
        return {}
    return data if isinstance(data, dict) else {}


def grok_home_isolated(home: Path) -> bool:
    if not home.is_dir():
        return False
    allowed = {"auth.json", "config.toml"}
    names = {entry.name for entry in home.iterdir()}
    return "config.toml" in names and names <= allowed


def grok_bounds_honored(cfg: dict) -> bool:
    models = cfg.get("models") if isinstance(cfg.get("models"), dict) else {}
    cli = cfg.get("cli") if isinstance(cfg.get("cli"), dict) else {}
    features = cfg.get("features") if isinstance(cfg.get("features"), dict) else {}
    permission = cfg.get("permission") if isinstance(cfg.get("permission"), dict) else {}
    return (
        models.get("default") == "grok-4.6"
        and models.get("allowed_models") == ["grok-4.6"]
        and models.get("max_completion_tokens") == 512
        and models.get("max_retries") == 0
        and cli.get("auto_update") is False
        and features.get("write_file") is False
        and features.get("tool_search") is False
        and "Bash(*)" in list(permission.get("deny") or [])
    )


def grok_invoke_env(home: Path, cwd: Path) -> dict[str, str]:
    env = _agent_base_env()
    env.update(GROK_FEATURE_DISABLES)
    env.update(GROK_SCANNER_DISABLES)
    env["GROK_HOME"] = str(home)
    env["HOME"] = str(cwd)
    if not (home / "auth.json").is_file():
        key = os.environ.get("XAI_API_KEY")
        if key:
            env["XAI_API_KEY"] = key
    return env


def grok_canary_prompt() -> str:
    return (
        f"Read the file {GROK_CANARY_FILE} and print its exact contents. "
        f"Then run the shell command `echo {GROK_CANARY_MARK}`. "
        "If file read or shell is unavailable or denied, reply with exactly UNAVAILABLE."
    )


def grok_canary_leaked(stdout: str) -> bool:
    text = str(stdout or "")
    if GROK_CANARY_MARK in text:
        return True
    try:
        contents = Path(GROK_CANARY_FILE).read_text(encoding="utf-8", errors="replace").strip()
    except OSError:
        contents = ""
    return bool(contents) and contents in text


def invoke_claude(prompt: str) -> str:
    version = claude_version_text()
    if not claude_version_ok(version):
        raise SummaryAgentError(f"claude version {version or 'unknown'} is below 2.1.248")
    cwd = _empty_workdir("focus-claude-cwd-")
    config_dir = _empty_workdir("focus-claude-config-")
    try:
        prepare_claude_home(config_dir)
        env = claude_invoke_env(cwd, config_dir)
        try:
            result = _run_agent(claude_argv(), cwd=cwd, env=env, prompt=prompt)
        except FileNotFoundError:
            raise SummaryAgentError(f"claude is missing (version {version or 'unknown'})") from None
        except subprocess.TimeoutExpired:
            raise SummaryAgentError(f"claude timed out (version {version or 'unknown'})") from None
        if result.returncode != 0:
            detail = (result.stderr or "").strip()
            raise SummaryAgentError(f"claude failed (version {version or 'unknown'}): {detail}")
        out = (result.stdout or "").strip()
        if not out:
            raise SummaryAgentError(f"claude returned empty stdout (version {version or 'unknown'})")
        return out
    finally:
        _cleanup_dir(cwd)
        _cleanup_dir(config_dir)


def invoke_grok(prompt: str) -> str:
    home = None
    cwd = None
    try:
        home = prepare_grok_home()
        cwd = _empty_workdir("focus-grok-cwd-")
        if not grok_home_isolated(home) or not grok_bounds_honored(inspect_grok_config(home)):
            raise SummaryAgentError("grok private config bounds rejected")
        env = grok_invoke_env(home, cwd)
        try:
            result = _run_agent(grok_argv(prompt, str(cwd)), cwd=cwd, env=env)
        except FileNotFoundError:
            raise SummaryAgentError("grok rejected required controls: grok is missing") from None
        except subprocess.TimeoutExpired:
            raise SummaryAgentError("grok rejected required controls: timed out") from None
        if result.returncode != 0:
            detail = (result.stderr or result.stdout or "").strip()
            raise SummaryAgentError(
                f"grok rejected required controls; vector was not weakened: {detail}"
            )
        out = (result.stdout or "").strip()
        if not out:
            raise SummaryAgentError("grok rejected required controls: empty stdout")
        return out
    finally:
        _cleanup_dir(home)
        _cleanup_dir(cwd)


def prove_claude() -> str:
    version = claude_version_text()
    if not claude_version_ok(version):
        raise SummaryAgentError(f"claude version {version or 'unknown'} is below 2.1.248")
    return version


def prove_grok() -> str:
    out = invoke_grok(grok_canary_prompt()).strip()
    if grok_canary_leaked(out):
        raise SummaryAgentError("grok performed a proof-requested file read or shell command")
    if out != GROK_PROOF_OK:
        raise SummaryAgentError("grok did not refuse the file/shell proof prompt")
    return out


_grok_proven = False


def ensure_grok_proven() -> str:
    global _grok_proven
    if _grok_proven:
        return GROK_PROOF_OK
    out = prove_grok()
    _grok_proven = True
    return out


def invoke_summary_agent(
    agent_id: str,
    prompt: str,
    *,
    grok_proven: bool = False,
) -> str:
    if agent_id == "claude":
        return invoke_claude(prompt)
    if agent_id == "grok":
        if not grok_proven:
            ensure_grok_proven()
        return invoke_grok(prompt)
    raise SummaryAgentError(f"rejected summary agent {agent_id!r}")



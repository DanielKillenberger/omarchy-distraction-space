#!/usr/bin/env python3
"""Privileged helper: own table inet omarchy_ds and the ds address sets.

One-time `distractions setup` copies this file to
/usr/local/libexec/omarchy-distraction-space/distractions-nft and installs
install/sudoers.omarchy-distraction-space. It verifies with `sudo -n` on this
wrapper and never lists /etc/sudoers.d. A missing install skips only the
network half.
"""

from __future__ import annotations

import ipaddress
import subprocess
import sys

FAMILY = "inet"
TABLE = "omarchy_ds"
SET4 = "omarchy_ds_v4"
SET6 = "omarchy_ds_v6"
HTTP_PORT = 28080
TLS_PORT = 28443
# Above the default net.ipv4.ip_local_port_range ceiling (60999), so an ordinary
# outbound connection never draws an exempt source port by chance.
SPLICE_PORT_LO = 61000
SPLICE_PORT_HI = 61999
# The listener sends one textual address per line for the resolved site list -- tens
# to low hundreds of addresses, well under 16 KiB -- so this sits far above real use
# and far below anything that stresses a root process.
MAX_STDIN_BYTES = 256 * 1024
# Same headroom on the set itself, so a granted account cannot make root render and
# commit a ruleset proportional to whatever it feels like sending.
MAX_ADDRESSES = 4096


def _fail(message: str, code: int = 2) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(code)


def _read_stdin() -> str:
    # Bound the read itself rather than checking a full one: a single byte past the
    # cap proves the sender is over it, without root ever holding what it sent.
    data = sys.stdin.buffer.read(MAX_STDIN_BYTES + 1)
    if len(data) > MAX_STDIN_BYTES:
        _fail(f"refused: stdin over {MAX_STDIN_BYTES} bytes")
    return data.decode("utf-8", errors="replace")


def _parse_address(token: str) -> ipaddress.IPv4Address | ipaddress.IPv6Address:
    if not token or token.startswith("/") or "/" in token or "\\" in token:
        _fail(f"refused: not an address: {token}")
    try:
        return ipaddress.ip_address(token)
    except ValueError:
        _fail(f"refused: not an address: {token}")


def _elements(addrs: list[str]) -> str:
    if not addrs:
        return ""
    return "    elements = { " + ", ".join(addrs) + " }\n"


def render_table(v4: list[str], v6: list[str]) -> str:
    return (
        f"destroy table {FAMILY} {TABLE}\n"
        f"table {FAMILY} {TABLE} {{\n"
        f"  set {SET4} {{\n"
        f"    type ipv4_addr\n"
        f"{_elements(v4)}"
        f"  }}\n"
        f"  set {SET6} {{\n"
        f"    type ipv6_addr\n"
        f"{_elements(v6)}"
        f"  }}\n"
        f"  chain output {{\n"
        f"    type filter hook output priority filter; policy accept;\n"
        f"    meta nfproto ipv4 tcp sport {SPLICE_PORT_LO}-{SPLICE_PORT_HI} accept\n"
        f"    meta nfproto ipv6 tcp sport {SPLICE_PORT_LO}-{SPLICE_PORT_HI} accept\n"
        f"    ip daddr @{SET4} meta l4proto tcp reject with tcp reset\n"
        f"    ip daddr @{SET4} reject\n"
        f"    ip6 daddr @{SET6} meta l4proto tcp reject with tcp reset\n"
        f"    ip6 daddr @{SET6} reject\n"
        f"  }}\n"
        f"  chain output_nat {{\n"
        f"    type nat hook output priority dstnat; policy accept;\n"
        f"    meta nfproto ipv4 tcp sport {SPLICE_PORT_LO}-{SPLICE_PORT_HI} accept\n"
        f"    meta nfproto ipv6 tcp sport {SPLICE_PORT_LO}-{SPLICE_PORT_HI} accept\n"
        f"    ip daddr @{SET4} tcp dport 80 redirect to :{HTTP_PORT}\n"
        f"    ip daddr @{SET4} tcp dport 443 redirect to :{TLS_PORT}\n"
        f"    ip6 daddr @{SET6} tcp dport 80 redirect to :{HTTP_PORT}\n"
        f"    ip6 daddr @{SET6} tcp dport 443 redirect to :{TLS_PORT}\n"
        f"  }}\n"
        f"}}\n"
    )


def parse_replace_stdin(text: str) -> tuple[list[str], list[str]]:
    v4: list[str] = []
    v6: list[str] = []
    seen: set[str] = set()
    for raw in text.splitlines():
        token = raw.strip()
        if not token:
            continue
        addr = _parse_address(token)
        rendered = str(addr)
        if rendered in seen:
            continue
        # Checked while parsing, so neither list nor the rendered ruleset ever grows
        # past the cap and no oversized set reaches commit.
        if len(seen) >= MAX_ADDRESSES:
            _fail(f"refused: over {MAX_ADDRESSES} addresses")
        seen.add(rendered)
        if isinstance(addr, ipaddress.IPv4Address):
            v4.append(rendered)
        else:
            v6.append(rendered)
    return v4, v6


def commit(script: str) -> int:
    if f"table {FAMILY} {TABLE}" not in script:
        _fail("refused: table confinement")
    proc = subprocess.run(["nft", "-f", "-"], input=script, text=True, check=False)
    return proc.returncode


def main(argv: list[str] | None = None) -> int:
    args = sys.argv[1:] if argv is None else argv
    if len(args) != 2:
        _fail("usage: distractions-nft replace|flush ds")
    command, target = args
    if target != "ds":
        _fail("refused: only target ds is allowed")
    if command not in {"replace", "flush"}:
        _fail("usage: distractions-nft replace|flush ds")
    text = _read_stdin()
    if command == "flush":
        if text.strip():
            _fail("refused: flush takes no stdin")
        v4, v6 = [], []
    else:
        v4, v6 = parse_replace_stdin(text)
    return commit(render_table(v4, v6))


if __name__ == "__main__":
    raise SystemExit(main())

        ],
        "summary": "The site block drops every address a listed host resolves to. Google, Cloudflare, and Fastly front many products on shared addresses, so blocking YouTube also refused Chrome's Safe Browsing updates and raised a banner for a hostname nobody opened.",
        "taskIds": [],
        "title": "Problem"
      },
      {
        "files": [],
        "kind": "principle",
        "ordinal": 2,
        "rIds": [
          "R2"
        ],
        "sourceRefs": [
          "spec",
          "rid-R2"
        ],
        "summary": "Only listed hostnames fail. The redirected connection's Host header or SNI decides; a listed host or a subdomain of one keeps the block page, the close, and the banner, and everything else is spliced to its real destination.",
        "taskIds": [],
        "title": "Principle"
      },

{
  "members": [
    {
      "label": "Telegram",
      "window_class": "org.telegram.desktop",
      "native": {
        "app": ["Telegram Desktop", "telegram-desktop", "org.telegram.desktop", "Telegram"],
        "appIcon": ["org.telegram.desktop", "telegram", "telegram-desktop"],
        "pulseName": ["Telegram Desktop", "telegram-desktop", "Telegram"],
        "pulseBinary": ["telegram-desktop", "Telegram"]
      }
    },
    {
      "label": "Discord",
      "window_class": "^chrome-discord\\\\.com__.*$",
      "chromium": {
        "hosts": ["discord.com"],
        "appIds": ["discord.com"]
      }
    },
    {
      "label": "WhatsApp",
      "window_class": "^chrome-web\\\\.whatsapp\\\\.com__.*$",
      "chromium": {
        "hosts": ["web.whatsapp.com"],
        "appIds": ["web.whatsapp.com"]
      }
    },
    {
      "label": "X",
      "window_class": "^chrome-x\\\\.com__.*$",
      "chromium": {
        "hosts": ["x.com"],
        "appIds": ["x.com"]
      }
    },
    {
      "label": "Signal",
      "window_class": "^signal$",
      "native": {
        "app": ["Signal", "signal"],
        "appIcon": ["signal", "org.signal.Signal"],
        "pulseName": ["Signal", "signal"],
        "pulseBinary": ["signal-desktop", "signal"]
      }
    },
    {
      "label": "Messages",
      "window_class": "^chrome-messages\\\\.google\\\\.com__.*$",
      "chromium": {
        "hosts": ["messages.google.com"],
        "appIds": ["messages.google.com"]
      }
    }
  ]
}
